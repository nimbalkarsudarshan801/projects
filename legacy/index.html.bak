  <script type="__bundler/template">
"<!DOCTYPE html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<title>Lumen Library – Membership<\u002Ftitle>\n<script src=\"d2d33512-4fb8-4d5d-8f77-ef47ea1f461c\"><\u002Fscript>\n<meta name=\"hz:slide-selector\" content=\"[data-canvas-width]\"><meta name=\"hz:canvas-width\" content=\"1360\"><meta name=\"hz:canvas-height\" content=\"1400\"><\u002Fhead>\n<body>\n<x-dc>\n<helmet>\n<style>/* latin-ext */\n@font-face {\n  font-family: 'DM Sans';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"2de51902-6954-4f14-8f26-6c149cd385d0\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'DM Sans';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"7fc0ba0c-4600-4c8d-8bbf-5073b3d45958\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'DM Sans';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"2de51902-6954-4f14-8f26-6c149cd385d0\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'DM Sans';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"7fc0ba0c-4600-4c8d-8bbf-5073b3d45958\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'DM Sans';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"2de51902-6954-4f14-8f26-6c149cd385d0\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'DM Sans';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"7fc0ba0c-4600-4c8d-8bbf-5073b3d45958\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(https://fonts.gstatic.com/s/fraunces/v38/6NU78FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c2Wa0KxCBTeO-U.woff2) format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"966baa27-3b71-4abb-831f-8ac1cbdbee46\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"9ab07836-24a6-43ea-bde2-b5aecc220051\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(https://fonts.gstatic.com/s/fraunces/v38/6NU78FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c2Wa0KxCBTeO-U.woff2) format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"966baa27-3b71-4abb-831f-8ac1cbdbee46\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"9ab07836-24a6-43ea-bde2-b5aecc220051\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\nbody{margin:0;background:#0E1116}\n*{box-sizing:border-box}\n:focus-visible{outline:2px solid #FFC247;outline-offset:3px}\n.serif{font-family:'Fraunces',Georgia,serif}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 24px;border-radius:999px;font:600 16px 'DM Sans',system-ui,sans-serif;cursor:pointer;text-decoration:none;border:1px solid transparent}\n.btn.pri{background:#FFC247;color:#1A1405}.btn.pri:hover{background:#FFD27A}\n.btn.pri:disabled{background:#2A313C;color:#98A1AE;cursor:not-allowed}\n.btn.sec{background:transparent;color:#F3EFE6;border-color:#3A424F}.btn.sec:hover{border-color:#8C96A5}\n.btn.sec:disabled{color:#98A1AE;border-color:#2A313C;cursor:default}\n.card{background:#12171E;border:1px solid #232A33;border-radius:20px;padding:28px}\n.lbl{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#98A1AE;margin:0}\n.tag{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:999px;font:600 12px 'DM Sans',system-ui,sans-serif;white-space:nowrap}\n.tag.ok{background:#14301F;color:#8FE0A8}.tag.warn{background:#3A2D0F;color:#FFC247}.tag.neu{background:#1D242E;color:#C9CFD8}\n.inp{height:52px;width:100%;border-radius:12px;border:1px solid #2F3743;background:#0E1116;color:#F3EFE6;padding:0 16px;font:400 16px 'DM Sans',system-ui,sans-serif}\n.inp::placeholder{color:#8A93A1}.inp:focus{border-color:#FFC247;outline:none}\n.fld{display:flex;flex-direction:column;gap:8px;min-width:0}\n.fld label{font-size:13px;font-weight:500;color:#C9CFD8}\n.seg{min-height:44px;padding:0 20px;border-radius:999px;border:1px solid #2F3743;background:#121720;color:#E6E9EE;font:500 15px 'DM Sans',system-ui,sans-serif;cursor:pointer}\n.seg:hover{border-color:#6B7585}.seg.on{background:#F3EFE6;color:#12161C;border-color:#F3EFE6}\n.plan{display:flex;flex-direction:column;gap:20px;padding:28px;border-radius:24px;border:1px solid #232A33;background:#12171E;text-align:left;color:#F3EFE6;font-family:'DM Sans',system-ui,sans-serif;cursor:pointer;height:100%}\n.plan:hover{border-color:#566070}\n.plan.on{border-color:#FFC247;background:#17150E}\n.ft{display:flex;gap:12px;font-size:15px;line-height:1.4;color:#D5DAE1}\n.mt{flex:1 1 120px;min-height:52px;padding:0 16px;border-radius:12px;border:1px solid #2F3743;background:#0E1116;color:#E6E9EE;font:500 15px 'DM Sans',system-ui,sans-serif;cursor:pointer}\n.mt:hover{border-color:#6B7585}.mt.on{border-color:#FFC247;background:#1A1810;color:#fff}\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<div style=\"background:#0E1116;color:#F3EFE6;font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased\" data-canvas-width=\"1360\" data-canvas-height=\"1400\" data-document-role=\"page\" data-label=\"Member · Membership &amp; payment\">\n  <dc-import name=\"Nav\" active=\"membership\" hint-size=\"100%,76px\"><\u002Fdc-import>\n\n  <main style=\"max-width:1280px;margin:0 auto;padding:56px 40px 96px\">\n    <div style=\"display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px 40px\">\n      <div>\n        <p class=\"lbl\" style=\"color:#FFC247\">Your plan: Student · valid till 31 Mar 2027<\u002Fp>\n        <h1 class=\"serif\" style=\"margin:12px 0 0;font-weight:400;font-size:clamp(40px,5vw,64px);line-height:1.05;letter-spacing:-0.025em\">Membership<\u002Fh1>\n      <\u002Fdiv>\n      <div role=\"group\" aria-label=\"Billing period\" style=\"display:flex;gap:8px\">\n        <button class=\"{{yearCls}}\" aria-pressed=\"{{yearPressed}}\" sc-camel-on-click=\"{{setYear}}\">Yearly<\u002Fbutton>\n        <button class=\"{{monthCls}}\" aria-pressed=\"{{monthPressed}}\" sc-camel-on-click=\"{{setMonth}}\">Monthly<\u002Fbutton>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <sc-if value=\"{{showForm}}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"margin-top:40px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:20px;align-items:stretch\">\n        <sc-for list=\"{{plans}}\" as=\"p\" hint-placeholder-count=\"3\">\n          <button class=\"{{p.cls}}\" aria-pressed=\"{{p.pressed}}\" sc-camel-on-click=\"{{p.pick}}\">\n            <span style=\"display:flex;align-items:center;justify-content:space-between;gap:12px\">\n              <span class=\"serif\" style=\"font-size:30px\">{{p.name}}<\u002Fspan>\n              <span class=\"{{p.tagCls}}\">{{p.tag}}<\u002Fspan>\n            <\u002Fspan>\n            <span style=\"display:flex;align-items:baseline;gap:8px\"><span class=\"serif\" style=\"font-size:48px;line-height:1\">₹{{p.price}}<\u002Fspan><span style=\"font-size:15px;color:#B4BBC6\">{{p.per}}<\u002Fspan><\u002Fspan>\n            <span style=\"display:flex;flex-direction:column;gap:12px;border-top:1px solid #2A313C;padding-top:20px\">\n              <sc-for list=\"{{p.features}}\" as=\"f\" hint-placeholder-count=\"4\">\n                <span class=\"ft\"><svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#FFC247\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"flex:0 0 20px;margin-top:1px\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"><\u002Fpath><\u002Fsvg><span>{{f.t}}<\u002Fspan><\u002Fspan>\n              <\u002Fsc-for>\n            <\u002Fspan>\n          <\u002Fbutton>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n\n      <!-- Checkout -->\n      <section class=\"card\" aria-labelledby=\"co-h\" style=\"margin-top:32px;display:flex;flex-wrap:wrap;gap:32px 48px\">\n        <div style=\"flex:1 1 360px;min-width:0\">\n          <h2 id=\"co-h\" class=\"serif\" style=\"margin:0 0 20px;font-weight:400;font-size:28px\">Pay for {{selName}}<\u002Fh2>\n          <div role=\"tablist\" aria-label=\"Payment method\" style=\"display:flex;flex-wrap:wrap;gap:10px;margin-bottom:20px\">\n            <sc-for list=\"{{methods}}\" as=\"m\" hint-placeholder-count=\"3\">\n              <button class=\"{{m.cls}}\" role=\"tab\" aria-selected=\"{{m.sel}}\" sc-camel-on-click=\"{{m.pick}}\">{{m.label}}<\u002Fbutton>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n          <sc-if value=\"{{isUpi}}\" hint-placeholder-val=\"{{ true }}\">\n            <div class=\"fld\"><label for=\"mu\">UPI ID<\u002Flabel><input id=\"mu\" class=\"inp\" type=\"text\" placeholder=\"name@bank\" value=\"{{upi}}\" sc-camel-on-input=\"{{onUpi}}\" autocomplete=\"off\"><\u002Fdiv>\n          <\u002Fsc-if>\n          <sc-if value=\"{{isCard}}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(160px,100%),1fr));gap:16px\">\n              <div class=\"fld\" style=\"grid-column:1 / -1\"><label for=\"mc\">Card number<\u002Flabel><input id=\"mc\" class=\"inp\" type=\"text\" inputmode=\"numeric\" placeholder=\"0000 0000 0000 0000\" value=\"{{cardNo}}\" sc-camel-on-input=\"{{onCardNo}}\" autocomplete=\"off\"><\u002Fdiv>\n              <div class=\"fld\"><label for=\"me\">Expiry<\u002Flabel><input id=\"me\" class=\"inp\" type=\"text\" inputmode=\"numeric\" placeholder=\"MM / YY\" value=\"{{cardExp}}\" sc-camel-on-input=\"{{onCardExp}}\" autocomplete=\"off\"><\u002Fdiv>\n              <div class=\"fld\"><label for=\"mv\">CVV<\u002Flabel><input id=\"mv\" class=\"inp\" type=\"password\" inputmode=\"numeric\" placeholder=\"3 digits\" value=\"{{cardCvv}}\" sc-camel-on-input=\"{{onCardCvv}}\" autocomplete=\"off\"><\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n          <sc-if value=\"{{isNet}}\" hint-placeholder-val=\"{{ false }}\">\n            <div class=\"fld\"><label for=\"mb\">Your bank<\u002Flabel>\n              <sc-raw-select id=\"mb\" class=\"inp\" sc-camel-on-change=\"{{onBank}}\" value=\"{{bank}}\">\n                <option value=\"\">Choose your bank<\u002Foption>\n                <option value=\"State Bank of India\">State Bank of India<\u002Foption>\n                <option value=\"HDFC Bank\">HDFC Bank<\u002Foption>\n                <option value=\"ICICI Bank\">ICICI Bank<\u002Foption>\n                <option value=\"Axis Bank\">Axis Bank<\u002Foption>\n                <option value=\"Bank of Maharashtra\">Bank of Maharashtra<\u002Foption>\n              <\u002Fsc-raw-select>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n        <\u002Fdiv>\n        <div style=\"flex:1 1 300px;min-width:0;display:flex;flex-direction:column;gap:16px;justify-content:space-between\">\n          <div>\n            <p class=\"lbl\">Summary<\u002Fp>\n            <div style=\"display:flex;justify-content:space-between;gap:16px;margin-top:16px;font-size:15px;color:#C9CFD8\"><span>{{selName}} · {{periodLabel}}<\u002Fspan><span>₹{{price}}<\u002Fspan><\u002Fdiv>\n            <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-top:16px;padding-top:20px;border-top:1px solid #2A313C\"><span style=\"font-size:15px;color:#C9CFD8\">Total today<\u002Fspan><span class=\"serif\" style=\"font-size:44px;line-height:1\">₹{{price}}<\u002Fspan><\u002Fdiv>\n          <\u002Fdiv>\n          <button class=\"btn pri\" disabled=\"{{cantPay}}\" sc-camel-on-click=\"{{pay}}\" style=\"width:100%\">{{payLabel}}<\u002Fbutton>\n        <\u002Fdiv>\n      <\u002Fsection>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{showDone}}\" hint-placeholder-val=\"{{ false }}\">\n      <section class=\"card\" role=\"status\" style=\"margin:40px auto 0;max-width:640px;padding:40px\">\n        <div style=\"display:flex;align-items:center;gap:16px\">\n          <span style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:50%;background:#FFC247;color:#1A1405\"><svg width=\"30\" height=\"30\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"><\u002Fpath><\u002Fsvg><\u002Fspan>\n          <h2 class=\"serif\" style=\"margin:0;font-weight:400;font-size:34px;line-height:1.1\">You are on {{selName}}<\u002Fh2>\n        <\u002Fdiv>\n        <p style=\"margin:20px 0 0;font-size:16px;line-height:1.6;color:#C9CFD8\">₹{{price}} paid ({{periodLabel}}). Your new limits apply straight away. A receipt is in your payment history.<\u002Fp>\n        <div style=\"margin-top:28px;display:flex;flex-wrap:wrap;gap:12px\">\n          <a class=\"btn pri\" href=\"Dashboard.dc.html\">Go to home<\u002Fa>\n          <a class=\"btn sec\" href=\"Payments.dc.html\">View payment history<\u002Fa>\n        <\u002Fdiv>\n      <\u002Fsection>\n    <\u002Fsc-if>\n  <\u002Fmain>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:1360,&quot;height&quot;:1400}}\">\nclass Component extends DCLogic {\n  constructor(props) {\n    super(props);\n    this.state = { billing: 'year', plan: 'standard', step: 'form', method: 'upi', upi: '', cardNo: '', cardExp: '', cardCvv: '', bank: '' };\n  }\n  renderVals() {\n    const s = this.state;\n    const self = this;\n    const year = s.billing === 'year';\n    const defs = [\n      { k: 'student', name: 'Student', y: 499, m: 59, feats: ['Borrow up to 5 books', '14-day loans, 2 renewals', 'Book up to 3 seats a week', 'Catalogue and reservations'] },\n      { k: 'standard', name: 'Standard', y: 899, m: 99, feats: ['Borrow up to 8 books', '21-day loans, 2 renewals', 'Book up to 5 seats a week', 'Reserve books before they return'] },\n      { k: 'premium', name: 'Premium', y: 1499, m: 169, feats: ['Borrow up to 12 books', '28-day loans, 3 renewals', 'Unlimited seat bookings', 'Quiet carrels and priority holds'] }\n    ];\n    const plans = defs.map((d) => {\n      const cur = d.k === 'student', sel = s.plan === d.k;\n      return {\n        name: d.name, price: year ? d.y : d.m, per: year ? 'per year' : 'per month',\n        tag: cur ? 'Current plan' : (sel ? 'Selected' : 'Choose'), tagCls: cur ? 'tag ok' : (sel ? 'tag warn' : 'tag neu'),\n        cls: sel ? 'plan on' : 'plan', pressed: sel ? 'true' : 'false',\n        features: d.feats.map((t) => ({ t })),\n        pick: () => self.setState({ plan: d.k })\n      };\n    });\n    const cur = defs.find((d) => d.k === s.plan);\n    const digits = (v) => v.replace(/\\D/g, '');\n    let ready = false;\n    if (s.method === 'upi') ready = /^[\\w.\\-]{2,}@[\\w]{2,}$/.test(s.upi.trim());\n    if (s.method === 'card') ready = digits(s.cardNo).length >= 12 && digits(s.cardExp).length === 4 && digits(s.cardCvv).length >= 3;\n    if (s.method === 'net') ready = s.bank !== '';\n    const busy = s.step === 'busy';\n    const price = year ? cur.y : cur.m;\n    return {\n      yearCls: year ? 'seg on' : 'seg', monthCls: year ? 'seg' : 'seg on',\n      yearPressed: year ? 'true' : 'false', monthPressed: year ? 'false' : 'true',\n      setYear: () => self.setState({ billing: 'year' }), setMonth: () => self.setState({ billing: 'month' }),\n      plans, selName: cur.name, price, periodLabel: year ? 'one year' : 'one month',\n      showForm: s.step !== 'done', showDone: s.step === 'done',\n      methods: [['upi', 'UPI'], ['card', 'Card'], ['net', 'Net banking']].map((m) => ({ label: m[1], cls: s.method === m[0] ? 'mt on' : 'mt', sel: s.method === m[0] ? 'true' : 'false', pick: () => self.setState({ method: m[0] }) })),\n      isUpi: s.method === 'upi', isCard: s.method === 'card', isNet: s.method === 'net',\n      upi: s.upi, cardNo: s.cardNo, cardExp: s.cardExp, cardCvv: s.cardCvv, bank: s.bank,\n      onUpi: (e) => self.setState({ upi: e.target.value }),\n      onCardNo: (e) => { const d = digits(e.target.value).slice(0, 16); self.setState({ cardNo: d.replace(/(.{4})/g, '$1 ').trim() }); },\n      onCardExp: (e) => { const d = digits(e.target.value).slice(0, 4); self.setState({ cardExp: d.length > 2 ? d.slice(0, 2) + ' / ' + d.slice(2) : d }); },\n      onCardCvv: (e) => self.setState({ cardCvv: digits(e.target.value).slice(0, 4) }),\n      onBank: (e) => self.setState({ bank: e.target.value }),\n      cantPay: !ready || busy,\n      payLabel: busy ? 'Processing…' : 'Pay ₹' + price,\n      pay: () => { self.setState({ step: 'busy' }); setTimeout(() => self.setState({ step: 'done' }), 1500); }\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html><!DOCTYPE html>
