 U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(https://fonts.gstatic.com/s/fraunces/v38/6NU78FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c2Wa0KxCBTeO-U.woff2) format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"2f5fd63b-aa9e-4464-ad11-cc700dcf1d24\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"42e7b4f6-fa54-413c-9c23-b2818dd86345\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\nbody{margin:0;background:#0E1116}\n*{box-sizing:border-box}\n:focus-visible{outline:2px solid #FFC247;outline-offset:3px}\n.serif{font-family:'Fraunces',Georgia,serif}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 24px;border-radius:999px;font:600 16px 'DM Sans',system-ui,sans-serif;cursor:pointer;text-decoration:none;border:1px solid transparent}\n.btn.pri{background:#FFC247;color:#1A1405}.btn.pri:hover{background:#FFD27A}\n.btn.pri:disabled{background:#2A313C;color:#98A1AE;cursor:not-allowed}\n.btn.sec{background:transparent;color:#F3EFE6;border-color:#3A424F}.btn.sec:hover{border-color:#8C96A5}\n.card{background:#12171E;border:1px solid #232A33;border-radius:20px;padding:28px}\n.lbl{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#98A1AE;margin:0}\n.tag{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:999px;font:600 12px 'DM Sans',system-ui,sans-serif;white-space:nowrap}\n.tag.ok{background:#14301F;color:#8FE0A8}.tag.warn{background:#3A2D0F;color:#FFC247}.tag.bad{background:#3D1C1C;color:#FF9E9E}.tag.neu{background:#1D242E;color:#C9CFD8}\n.inp{height:52px;width:100%;border-radius:12px;border:1px solid #2F3743;background:#0E1116;color:#F3EFE6;padding:0 16px;font:400 16px 'DM Sans',system-ui,sans-serif}\n.inp::placeholder{color:#8A93A1}\n.inp:focus{border-color:#FFC247;outline:none}\n.fld{display:flex;flex-direction:column;gap:8px;min-width:0}\n.fld label{font-size:13px;font-weight:500;color:#C9CFD8}\n.mt{flex:1 1 140px;min-height:64px;padding:10px 16px;border-radius:14px;border:1px solid #2F3743;background:#0E1116;color:#E6E9EE;font:500 15px 'DM Sans',system-ui,sans-serif;cursor:pointer;display:flex;align-items:center;gap:12px;text-align:left}\n.mt:hover{border-color:#6B7585}\n.mt.on{border-color:#FFC247;background:#1A1810;color:#fff}\n.fr{display:flex;align-items:center;gap:16px;padding:16px 0;border-top:1px solid #232A33;cursor:pointer}\n.fr:first-of-type{border-top:0}\n.sm{display:flex;justify-content:space-between;gap:16px;padding:8px 0;font-size:15px;color:#C9CFD8}\n.hr{display:grid;grid-template-columns:1.4fr 1fr 1fr auto;gap:12px;align-items:center;padding:16px 0;border-top:1px solid #232A33;font-size:15px}\n@media (max-width:640px){.hr{grid-template-columns:1fr auto}.hr .hc{display:none}}\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<div style=\"background:#0E1116;color:#F3EFE6;font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased\" data-canvas-width=\"1360\" data-canvas-height=\"1500\" data-document-role=\"page\" data-label=\"Member · Fines &amp; payment\">\n  <dc-import name=\"Nav\" active=\"payments\" hint-size=\"100%,76px\"><\u002Fdc-import>\n\n  <main style=\"max-width:1280px;margin:0 auto;padding:56px 40px 96px\">\n    <h1 class=\"serif\" style=\"margin:0 0 32px;font-weight:400;font-size:clamp(40px,5vw,64px);line-height:1.05;letter-spacing:-0.025em\">Fines &amp; payments<\u002Fh1>\n\n    <!-- ========== Checkout ========== -->\n    <sc-if value=\"{{showCheckout}}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"display:flex;flex-wrap:wrap;gap:24px;align-items:flex-start\">\n        <div style=\"flex:999 1 560px;min-width:0;display:flex;flex-direction:column;gap:24px\">\n\n          <section class=\"card\" aria-labelledby=\"f-h\">\n            <h2 id=\"f-h\" class=\"serif\" style=\"margin:0 0 8px;font-weight:400;font-size:26px\">1. What you are paying<\u002Fh2>\n            <sc-for list=\"{{fines}}\" as=\"f\" hint-placeholder-count=\"2\">\n              <label class=\"fr\">\n                <input type=\"checkbox\" checked=\"{{f.checked}}\" sc-camel-on-change=\"{{f.toggle}}\" style=\"width:24px;height:24px;accent-color:#FFC247;flex:0 0 24px\">\n                <span style=\"flex:1 1 auto;min-width:0\">\n                  <span style=\"display:block;font-size:16px;font-weight:600\">{{f.title}}<\u002Fspan>\n                  <span style=\"display:block;margin-top:2px;font-size:14px;color:#B4BBC6\">{{f.note}}<\u002Fspan>\n                <\u002Fspan>\n                <span class=\"serif\" style=\"font-size:24px\">₹{{f.amount}}<\u002Fspan>\n              <\u002Flabel>\n            <\u002Fsc-for>\n          <\u002Fsection>\n\n          <section class=\"card\" aria-labelledby=\"m-h\">\n            <h2 id=\"m-h\" class=\"serif\" style=\"margin:0 0 20px;font-weight:400;font-size:26px\">2. How you want to pay<\u002Fh2>\n            <div role=\"tablist\" aria-label=\"Payment method\" style=\"display:flex;flex-wrap:wrap;gap:10px\">\n              <sc-for list=\"{{methods}}\" as=\"m\" hint-placeholder-count=\"3\">\n                <button class=\"{{m.cls}}\" role=\"tab\" aria-selected=\"{{m.sel}}\" sc-camel-on-click=\"{{m.pick}}\">\n                  <svg width=\"24\" height=\"24\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"{{m.icon}}\"><\u002Fpath><\u002Fsvg>\n                  <span>{{m.label}}<\u002Fspan>\n                <\u002Fbutton>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n\n            <div style=\"margin-top:24px\">\n              <sc-if value=\"{{isUpi}}\" hint-placeholder-val=\"{{ true }}\">\n                <div style=\"display:flex;flex-wrap:wrap;gap:28px;align-items:flex-start\">\n                  <div class=\"fld\" style=\"flex:1 1 260px\">\n                    <label for=\"upi\">UPI ID<\u002Flabel>\n                    <input id=\"upi\" class=\"inp\" type=\"text\" inputmode=\"email\" placeholder=\"name@bank\" value=\"{{upi}}\" sc-camel-on-input=\"{{onUpi}}\" autocomplete=\"off\">\n                    <span style=\"font-size:13px;color:#98A1AE\">You will get a request in your UPI app to approve.<\u002Fspan>\n                  <\u002Fdiv>\n                  <div style=\"flex:0 0 auto;display:flex;flex-direction:column;align-items:center;gap:8px\">\n                    <div style=\"padding:10px;background:#F3EFE6;border-radius:12px\">\n                      <svg width=\"116\" height=\"116\" sc-camel-view-box=\"0 0 29 29\" role=\"img\" aria-label=\"Sample QR code placeholder\">\n                        <rect width=\"29\" height=\"29\" fill=\"#F3EFE6\"><\u002Frect>\n                        <g fill=\"#12161C\"><path d=\"M1 1h7v7H1zM21 1h7v7h-7zM1 21h7v7H1z\"><\u002Fpath><path d=\"M10 1h2v2h-2zM13 3h3v2h-3zM10 6h2v2h-2zM15 7h2v3h-2zM18 1h2v4h-2zM10 10h3v2h-3zM14 12h2v3h-2zM18 10h2v2h-2zM21 12h3v2h-3zM25 10h3v3h-3zM1 10h2v3H1zM4 12h3v2H4zM9 14h3v3H9zM13 18h3v2h-3zM18 15h3v3h-3zM23 16h2v4h-2zM26 18h2v3h-2zM10 21h3v3h-3zM15 22h2v3h-2zM19 21h3v2h-3zM22 25h3v3h-3zM10 26h3v2h-3zM17 26h3v2h-3z\"><\u002Fpath><\u002Fg>\n                        <g fill=\"#F3EFE6\"><path d=\"M2 2h5v5H2zM22 2h5v5h-5zM2 22h5v5H2z\"><\u002Fpath><\u002Fg>\n                        <g fill=\"#12161C\"><path d=\"M3 3h3v3H3zM23 3h3v3h-3zM3 23h3v3H3z\"><\u002Fpath><\u002Fg>\n                      <\u002Fsvg>\n                    <\u002Fdiv>\n                    <span style=\"font-size:12px;color:#98A1AE\">Or scan with any UPI app<\u002Fspan>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n\n              <sc-if value=\"{{isCard}}\" hint-placeholder-val=\"{{ false }}\">\n                <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr));gap:16px\">\n                  <div class=\"fld\" style=\"grid-column:1 / -1\">\n                    <label for=\"cn\">Card number<\u002Flabel>\n                    <input id=\"cn\" class=\"inp\" type=\"text\" inputmode=\"numeric\" placeholder=\"0000 0000 0000 0000\" value=\"{{cardNo}}\" sc-camel-on-input=\"{{onCardNo}}\" autocomplete=\"off\">\n                  <\u002Fdiv>\n                  <div class=\"fld\" style=\"grid-column:1 / -1\">\n                    <label for=\"cname\">Name on card<\u002Flabel>\n                    <input id=\"cname\" class=\"inp\" type=\"text\" placeholder=\"As printed on the card\" value=\"{{cardName}}\" sc-camel-on-input=\"{{onCardName}}\" autocomplete=\"off\">\n                  <\u002Fdiv>\n                  <div class=\"fld\">\n                    <label for=\"cexp\">Expiry<\u002Flabel>\n                    <input id=\"cexp\" class=\"inp\" type=\"text\" inputmode=\"numeric\" placeholder=\"MM / YY\" value=\"{{cardExp}}\" sc-camel-on-input=\"{{onCardExp}}\" autocomplete=\"off\">\n                  <\u002Fdiv>\n                  <div class=\"fld\">\n                    <label for=\"cvv\">CVV<\u002Flabel>\n                    <input id=\"cvv\" class=\"inp\" type=\"password\" inputmode=\"numeric\" placeholder=\"3 digits\" value=\"{{cardCvv}}\" sc-camel-on-input=\"{{onCardCvv}}\" autocomplete=\"off\">\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n\n              <sc-if value=\"{{isNet}}\" hint-placeholder-val=\"{{ false }}\">\n                <div class=\"fld\" style=\"max-width:420px\">\n                  <label for=\"bank\">Your bank<\u002Flabel>\n                  <sc-raw-select id=\"bank\" class=\"inp\" sc-camel-on-change=\"{{onBank}}\" value=\"{{bank}}\">\n                    <option value=\"\">Choose your bank<\u002Foption>\n                    <option value=\"State Bank of India\">State Bank of India<\u002Foption>\n                    <option value=\"HDFC Bank\">HDFC Bank<\u002Foption>\n                    <option value=\"ICICI Bank\">ICICI Bank<\u002Foption>\n                    <option value=\"Axis Bank\">Axis Bank<\u002Foption>\n                    <option value=\"Bank of Maharashtra\">Bank of Maharashtra<\u002Foption>\n                  <\u002Fsc-raw-select>\n                  <span style=\"font-size:13px;color:#98A1AE\">You will be sent to your bank to sign in and approve.<\u002Fspan>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n            <\u002Fdiv>\n          <\u002Fsection>\n        <\u002Fdiv>\n\n        <!-- Summary -->\n        <aside class=\"card\" aria-label=\"Order summary\" style=\"flex:1 1 320px;min-width:0\">\n          <p class=\"lbl\">Summary<\u002Fp>\n          <div style=\"margin-top:16px\">\n            <sc-for list=\"{{lines}}\" as=\"l\" hint-placeholder-count=\"2\">\n              <div class=\"sm\"><span>{{l.title}}<\u002Fspan><span>₹{{l.amount}}<\u002Fspan><\u002Fdiv>\n            <\u002Fsc-for>\n            <sc-if value=\"{{noLines}}\" hint-placeholder-val=\"{{ false }}\">\n              <p style=\"margin:0;font-size:15px;color:#98A1AE\">Nothing selected.<\u002Fp>\n            <\u002Fsc-if>\n          <\u002Fdiv>\n          <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin:16px 0 24px;padding-top:20px;border-top:1px solid #2A313C\">\n            <span style=\"font-size:15px;color:#C9CFD8\">Total<\u002Fspan>\n            <span class=\"serif\" style=\"font-size:44px;line-height:1\">₹{{total}}<\u002Fspan>\n          <\u002Fdiv>\n          <button class=\"btn pri\" style=\"width:100%\" disabled=\"{{cantPay}}\" sc-camel-on-click=\"{{pay}}\">{{payLabel}}<\u002Fbutton>\n          <p style=\"margin:16px 0 0;font-size:13px;line-height:1.5;color:#98A1AE\">Payments are processed securely. You will get a receipt here and by email.<\u002Fp>\n        <\u002Faside>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n\n    <!-- ========== Success ========== -->\n    <sc-if value=\"{{showDone}}\" hint-placeholder-val=\"{{ false }}\">\n      <section class=\"card\" role=\"status\" style=\"max-width:640px;margin:0 auto;padding:40px\">\n        <div style=\"display:flex;align-items:center;gap:16px\">\n          <span style=\"display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:50%;background:#FFC247;color:#1A1405\">\n            <svg width=\"30\" height=\"30\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"><\u002Fpath><\u002Fsvg>\n          <\u002Fspan>\n          <div>\n            <h2 class=\"serif\" style=\"margin:0;font-weight:400;font-size:34px;line-height:1.1\">Payment received<\u002Fh2>\n            <p style=\"margin:4px 0 0;font-size:15px;color:#B4BBC6\">Your fines are cleared.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <dl style=\"margin:32px 0 0;display:grid;grid-template-columns:auto 1fr;gap:14px 24px;font-size:15px;padding-top:24px;border-top:1px solid #2A313C\">\n          <dt style=\"color:#98A1AE\">Receipt<\u002Fdt><dd style=\"margin:0;text-align:right\">LMN-R-20841<\u002Fdd>\n          <dt style=\"color:#98A1AE\">Paid on<\u002Fdt><dd style=\"margin:0;text-align:right\">Thu 29 Oct 2026<\u002Fdd>\n          <dt style=\"color:#98A1AE\">Method<\u002Fdt><dd style=\"margin:0;text-align:right\">{{methodLabel}}<\u002Fdd>\n          <dt style=\"color:#98A1AE\">Items<\u002Fdt><dd style=\"margin:0;text-align:right\">{{itemsText}}<\u002Fdd>\n          <dt style=\"color:#98A1AE\">Amount<\u002Fdt><dd class=\"serif\" style=\"margin:0;text-align:right;font-size:28px;line-height:1\">₹{{total}}<\u002Fdd>\n        <\u002Fdl>\n        <div style=\"margin-top:32px;display:flex;flex-wrap:wrap;gap:12px\">\n          <button class=\"btn sec\">Download receipt<\u002Fbutton>\n          <a class=\"btn pri\" href=\"Loans.dc.html\">Back to my loans<\u002Fa>\n        <\u002Fdiv>\n      <\u002Fsection>\n    <\u002Fsc-if>\n\n    <!-- ========== History ========== -->\n    <section class=\"card\" aria-labelledby=\"h-h\" style=\"margin-top:32px\">\n      <h2 id=\"h-h\" class=\"serif\" style=\"margin:0 0 8px;font-weight:400;font-size:26px\">Payment history<\u002Fh2>\n      <div class=\"hr\" style=\"border-top:0;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#98A1AE\">\n        <span>For<\u002Fspan><span class=\"hc\">Date<\u002Fspan><span class=\"hc\">Method<\u002Fspan><span>Amount<\u002Fspan>\n      <\u002Fdiv>\n      <sc-for list=\"{{history}}\" as=\"p\" hint-placeholder-count=\"3\">\n        <div class=\"hr\">\n          <span>{{p.what}}<\u002Fspan><span class=\"hc\" style=\"color:#B4BBC6\">{{p.date}}<\u002Fspan><span class=\"hc\" style=\"color:#B4BBC6\">{{p.method}}<\u002Fspan><span style=\"font-weight:600\">₹{{p.amount}}<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fsc-for>\n    <\u002Fsection>\n  <\u002Fmain>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:1360,&quot;height&quot;:1500}}\">\nclass Component extends DCLogic {\n  constructor(props) {\n    super(props);\n    this.state = { step: 'pay', method: 'upi', off: {}, upi: '', cardNo: '', cardName: '', cardExp: '', cardCvv: '', bank: '' };\n  }\n  renderVals() {\n    const s = this.state;\n    const self = this;\n    const finesBase = [\n      { id: 'os', title: 'Overdue · Operating System Concepts', note: '6 days × ₹5 · still on loan, grows ₹5 each day', amount: 30 },\n      { id: 'db', title: 'Late return · Database System Concepts', note: '4 days × ₹5 · returned 14 Oct', amount: 20 }\n    ];\n    const fines = finesBase.map((f) => ({\n      title: f.title, note: f.note, amount: f.amount, checked: !s.off[f.id],\n      toggle: () => { const o = Object.assign({}, s.off); o[f.id] = !o[f.id]; self.setState({ off: o }); }\n    }));\n    const chosen = finesBase.filter((f) => !s.off[f.id]);\n    const total = chosen.reduce((a, f) => a + f.amount, 0);\n    const mDefs = [\n      { k: 'upi', label: 'UPI', icon: 'M7 3h10a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM11 18h2' },\n      { k: 'card', label: 'Card', icon: 'M3 6h18v12H3zM3 10h18M7 15h4' },\n      { k: 'net', label: 'Net banking', icon: 'M3 10l9-6 9 6M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20h18' }\n    ];\n    const methods = mDefs.map((m) => ({\n      label: m.label, icon: m.icon,\n      cls: s.method === m.k ? 'mt on' : 'mt', sel: s.method === m.k ? 'true' : 'false',\n      pick: () => self.setState({ method: m.k })\n    }));\n    const digits = (v) => v.replace(/\\D/g, '');\n    let ready = false;\n    if (s.method === 'upi') ready = /^[\\w.\\-]{2,}@[\\w]{2,}$/.test(s.upi.trim());\n    if (s.method === 'card') ready = digits(s.cardNo).length >= 12 && s.cardName.trim().length > 1 && digits(s.cardExp).length === 4 && digits(s.cardCvv).length >= 3;\n    if (s.method === 'net') ready = s.bank !== '';\n    const busy = s.step === 'busy';\n    const label = { upi: 'UPI', card: 'Card', net: 'Net banking' }[s.method];\n    return {\n      showCheckout: s.step !== 'done', showDone: s.step === 'done',\n      fines, methods, total,\n      lines: chosen.map((f) => ({ title: f.title, amount: f.amount })),\n      noLines: chosen.length === 0,\n      isUpi: s.method === 'upi', isCard: s.method === 'card', isNet: s.method === 'net',\n      upi: s.upi, cardNo: s.cardNo, cardName: s.cardName, cardExp: s.cardExp, cardCvv: s.cardCvv, bank: s.bank,\n      onUpi: (e) => self.setState({ upi: e.target.value }),\n      onCardNo: (e) => { const d = digits(e.target.value).slice(0, 16); self.setState({ cardNo: d.replace(/(.{4})/g, '$1 ').trim() }); },\n      onCardName: (e) => self.setState({ cardName: e.target.value }),\n      onCardExp: (e) => { const d = digits(e.target.value).slice(0, 4); self.setState({ cardExp: d.length > 2 ? d.slice(0, 2) + ' / ' + d.slice(2) : d }); },\n      onCardCvv: (e) => self.setState({ cardCvv: digits(e.target.value).slice(0, 4) }),\n      onBank: (e) => self.setState({ bank: e.target.value }),\n      cantPay: !ready || total === 0 || busy,\n      payLabel: busy ? 'Processing…' : 'Pay ₹' + total,\n      pay: () => { self.setState({ step: 'busy' }); setTimeout(() => self.setState({ step: 'done' }), 1500); },\n      methodLabel: label, itemsText: chosen.length + (chosen.length === 1 ? ' fine' : ' fines'),\n      history: [\n        { what: 'Late fee · Sapiens', date: '3 Sep 2026', method: 'UPI', amount: 15 },\n        { what: 'Student plan · annual', date: '1 Apr 2026', method: 'Card', amount: 499 },\n        { what: 'Late fee · Pride and Prejudice', date: '12 Feb 2026', method: 'UPI', amount: 10 }\n      ]\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html><!DOCTYPE html>
