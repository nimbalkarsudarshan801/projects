[{"id":"./Nav.dc.html","uuid":"063c2219-7b6b-42b2-a15b-4a9a90d6c8fe"},{"id":"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Fraunces:opsz,wght@9..144,400;9..144,600&display=swap","uuid":"8559d864-9908-4a77-91da-d5b6f9c804d9"},{"id":"https://cdn.jsdelivr.net/npm/react@18.3.1/umd/react.production.min.js","uuid":"e54b34d0-f5b5-46dd-9e7a-817f015df5d9"},{"id":"https://cdn.jsdelivr.net/npm/react-dom@18.3.1/umd/react-dom.production.min.js","uuid":"8ed9822f-2508-4fa1-bf1f-2a6c84757543"}]
  </script>

