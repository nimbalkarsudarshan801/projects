"<!DOCTYPE html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<title>Lumen Library – My loans<\u002Ftitle>\n<script src=\"a579df80-8fe1-4c57-846e-91d58ca52e14\"><\u002Fscript>\n<meta name=\"hz:slide-selector\" content=\"[data-canvas-width]\"><meta name=\"hz:canvas-width\" content=\"1360\"><meta name=\"hz:canvas-height\" content=\"1400\"><\u002Fhead>\n<body>\n<x-dc>\n<helmet>\n<style>/* latin-ext */\n@font-face {\n  font-family: 'DM Sans';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"e2737252-bdbe-4d5c-ba12-6fa390696686\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'DM Sans';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"05d6e700-5559-4eb7-b9bd-2ba49fa36d80\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'DM Sans';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"e2737252-bdbe-4d5c-ba12-6fa390696686\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'DM Sans';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"05d6e700-5559-4eb7-b9bd-2ba49fa36d80\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'DM Sans';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"e2737252-bdbe-4d5c-ba12-6fa390696686\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'DM Sans';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"05d6e700-5559-4eb7-b9bd-2ba49fa36d80\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(https://fonts.gstatic.com/s/fraunces/v38/6NU78FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c2Wa0KxCBTeO-U.woff2) format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"f8ddbcd2-db72-4ace-a890-f14e6115c3cd\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"a327e59b-f8bc-4236-a9bf-473c02796b10\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(https://fonts.gstatic.com/s/fraunces/v38/6NU78FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c2Wa0KxCBTeO-U.woff2) format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"f8ddbcd2-db72-4ace-a890-f14e6115c3cd\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"a327e59b-f8bc-4236-a9bf-473c02796b10\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\nbody{margin:0;background:#0E1116}\n*{box-sizing:border-box}\n:focus-visible{outline:2px solid #FFC247;outline-offset:3px}\n.serif{font-family:'Fraunces',Georgia,serif}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 24px;border-radius:999px;font:600 15px 'DM Sans',system-ui,sans-serif;cursor:pointer;text-decoration:none;border:1px solid transparent}\n.btn.pri{background:#FFC247;color:#1A1405}.btn.pri:hover{background:#FFD27A}\n.btn.sec{background:transparent;color:#F3EFE6;border-color:#3A424F}.btn.sec:hover{border-color:#8C96A5}\n.btn.sm{min-height:44px;padding:0 18px;font-size:14px}\n.btn:disabled{color:#98A1AE;border-color:#2A313C;cursor:default}\n.card{background:#12171E;border:1px solid #232A33;border-radius:20px;padding:24px}\n.lbl{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#98A1AE;margin:0}\n.tag{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:999px;font:600 12px 'DM Sans',system-ui,sans-serif;white-space:nowrap}\n.tag.ok{background:#14301F;color:#8FE0A8}.tag.warn{background:#3A2D0F;color:#FFC247}.tag.bad{background:#3D1C1C;color:#FF9E9E}.tag.neu{background:#1D242E;color:#C9CFD8}\n.cv{aspect-ratio:2/3;border-radius:3px 6px 6px 3px;box-shadow:inset 5px 0 0 rgba(0,0,0,.28);width:56px;flex:0 0 56px}\n.tab{min-height:48px;padding:0 20px;border:0;border-bottom:2px solid transparent;background:transparent;color:#B4BBC6;font:500 16px 'DM Sans',system-ui,sans-serif;cursor:pointer}\n.tab:hover{color:#fff}\n.tab.on{color:#F3EFE6;border-bottom-color:#FFC247}\n.ln{display:flex;flex-wrap:wrap;align-items:center;gap:16px 20px;padding:20px 0;border-top:1px solid #232A33}\n.ln:first-of-type{border-top:0}\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<div style=\"background:#0E1116;color:#F3EFE6;font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased\" data-canvas-width=\"1360\" data-canvas-height=\"1400\" data-document-role=\"page\" data-label=\"Member · My loans\">\n  <dc-import name=\"Nav\" active=\"loans\" hint-size=\"100%,76px\"><\u002Fdc-import>\n\n  <main style=\"max-width:1280px;margin:0 auto;padding:56px 40px 96px\">\n    <div style=\"display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px 40px\">\n      <h1 class=\"serif\" style=\"margin:0;font-weight:400;font-size:clamp(40px,5vw,64px);line-height:1.05;letter-spacing:-0.025em\">My loans<\u002Fh1>\n      <p style=\"margin:0;font-size:15px;color:#B4BBC6\">3 of 5 books on loan · each book can be renewed twice<\u002Fp>\n    <\u002Fdiv>\n\n    <div role=\"tablist\" aria-label=\"Loan views\" style=\"margin-top:32px;display:flex;flex-wrap:wrap;border-bottom:1px solid #232A33\">\n      <sc-for list=\"{{tabs}}\" as=\"t\" hint-placeholder-count=\"3\">\n        <button class=\"{{t.cls}}\" role=\"tab\" aria-selected=\"{{t.sel}}\" sc-camel-on-click=\"{{t.pick}}\">{{t.label}}<\u002Fbutton>\n      <\u002Fsc-for>\n    <\u002Fdiv>\n\n    <div style=\"margin-top:24px;display:flex;flex-wrap:wrap;gap:24px;align-items:flex-start\">\n      <section class=\"card\" style=\"flex:999 1 560px;min-width:0\" aria-live=\"polite\">\n\n        <sc-if value=\"{{showCurrent}}\" hint-placeholder-val=\"{{ true }}\">\n          <sc-for list=\"{{loans}}\" as=\"l\" hint-placeholder-count=\"3\">\n            <div class=\"ln\">\n              <div class=\"cv\" style=\"background: {{l.c}}\"><\u002Fdiv>\n              <div style=\"flex:1 1 220px;min-width:0\">\n                <p style=\"margin:0;font-size:17px;font-weight:600;line-height:1.3\">{{l.title}}<\u002Fp>\n                <p style=\"margin:2px 0 0;font-size:14px;color:#B4BBC6\">{{l.author}}<\u002Fp>\n                <p style=\"margin:8px 0 0;font-size:14px;color:#98A1AE\">Borrowed {{l.from}} · Due <strong style=\"color:#F3EFE6;font-weight:600\">{{l.due}}<\u002Fstrong><\u002Fp>\n              <\u002Fdiv>\n              <span class=\"{{l.tagCls}}\">{{l.tag}}<\u002Fspan>\n              <sc-if value=\"{{l.canRenew}}\" hint-placeholder-val=\"{{ true }}\">\n                <button class=\"btn sec sm\" sc-camel-on-click=\"{{l.renew}}\">{{l.renewLabel}}<\u002Fbutton>\n              <\u002Fsc-if>\n              <sc-if value=\"{{l.mustPay}}\" hint-placeholder-val=\"{{ false }}\">\n                <a class=\"btn pri sm\" href=\"Payments.dc.html\">Pay ₹30 fine<\u002Fa>\n              <\u002Fsc-if>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fsc-if>\n\n        <sc-if value=\"{{showRes}}\" hint-placeholder-val=\"{{ false }}\">\n          <sc-for list=\"{{reservations}}\" as=\"r\" hint-placeholder-count=\"2\">\n            <div class=\"ln\">\n              <div class=\"cv\" style=\"background: {{r.c}}\"><\u002Fdiv>\n              <div style=\"flex:1 1 220px;min-width:0\">\n                <p style=\"margin:0;font-size:17px;font-weight:600;line-height:1.3\">{{r.title}}<\u002Fp>\n                <p style=\"margin:2px 0 0;font-size:14px;color:#B4BBC6\">{{r.author}}<\u002Fp>\n                <p style=\"margin:8px 0 0;font-size:14px;color:#98A1AE\">{{r.note}}<\u002Fp>\n              <\u002Fdiv>\n              <span class=\"{{r.tagCls}}\">{{r.tag}}<\u002Fspan>\n              <button class=\"btn sec sm\" sc-camel-on-click=\"{{r.cancel}}\">Cancel<\u002Fbutton>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n          <sc-if value=\"{{noRes}}\" hint-placeholder-val=\"{{ false }}\">\n            <p style=\"margin:0;padding:24px 0;font-size:15px;color:#B4BBC6\">No active reservations.<\u002Fp>\n          <\u002Fsc-if>\n        <\u002Fsc-if>\n\n        <sc-if value=\"{{showHist}}\" hint-placeholder-val=\"{{ false }}\">\n          <sc-for list=\"{{history}}\" as=\"h\" hint-placeholder-count=\"4\">\n            <div class=\"ln\">\n              <div class=\"cv\" style=\"background: {{h.c}}\"><\u002Fdiv>\n              <div style=\"flex:1 1 220px;min-width:0\">\n                <p style=\"margin:0;font-size:17px;font-weight:600;line-height:1.3\">{{h.title}}<\u002Fp>\n                <p style=\"margin:2px 0 0;font-size:14px;color:#B4BBC6\">{{h.author}}<\u002Fp>\n                <p style=\"margin:8px 0 0;font-size:14px;color:#98A1AE\">Returned {{h.ret}}<\u002Fp>\n              <\u002Fdiv>\n              <span class=\"{{h.tagCls}}\">{{h.tag}}<\u002Fspan>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fsc-if>\n      <\u002Fsection>\n\n      <aside style=\"flex:1 1 300px;min-width:0;display:flex;flex-direction:column;gap:24px\">\n        <section class=\"card\">\n          <p class=\"lbl\">Fines due<\u002Fp>\n          <p class=\"serif\" style=\"margin:12px 0 4px;font-size:48px;line-height:1;color:#FF9E9E\">₹50<\u002Fp>\n          <p style=\"margin:0 0 20px;font-size:14px;color:#B4BBC6\">Late fees at ₹5 per day. Unpaid fines block renewals and seat bookings.<\u002Fp>\n          <a class=\"btn pri\" href=\"Payments.dc.html\" style=\"width:100%\">Review and pay<\u002Fa>\n        <\u002Fsection>\n        <section class=\"card\">\n          <p class=\"lbl\">How returns work<\u002Fp>\n          <p style=\"margin:12px 0 0;font-size:15px;line-height:1.6;color:#B4BBC6\">Drop the book at the return desk or the night drop box. It leaves your loans once staff scan it in.<\u002Fp>\n        <\u002Fsection>\n      <\u002Faside>\n    <\u002Fdiv>\n  <\u002Fmain>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:1360,&quot;height&quot;:1400}}\">\nclass Component extends DCLogic {\n  constructor(props) {\n    super(props);\n    this.state = { tab: 'current', renewed: {}, cancelled: {} };\n  }\n  renderVals() {\n    const s = this.state;\n    const self = this;\n    const tabs = [['current', 'On loan (3)'], ['res', 'Reservations'], ['hist', 'History']].map((t) => ({\n      label: t[1], cls: s.tab === t[0] ? 'tab on' : 'tab', sel: s.tab === t[0] ? 'true' : 'false',\n      pick: () => self.setState({ tab: t[0] })\n    }));\n    const base = [\n      { id: 'os', title: 'Operating System Concepts', author: 'Silberschatz, Galvin, Gagne', c: '#7A3F33', from: '9 Oct', due: 'Fri 23 Oct', overdue: true },\n      { id: 'cc', title: 'Clean Code', author: 'Robert C. Martin', c: '#3E5C6B', from: '19 Oct', due: 'Mon 2 Nov', newDue: 'Mon 16 Nov', soon: true },\n      { id: 'ia', title: 'Introduction to Algorithms', author: 'Cormen, Leiserson, Rivest, Stein', c: '#4A5B45', from: '24 Oct', due: 'Sat 7 Nov', newDue: 'Sat 21 Nov' }\n    ];\n    const loans = base.map((b) => {\n      const r = !!s.renewed[b.id];\n      return {\n        title: b.title, author: b.author, c: b.c, from: b.from,\n        due: r ? b.newDue : b.due,\n        tag: b.overdue ? 'Overdue 6 days' : (r ? 'Renewed' : (b.soon ? 'Due in 4 days' : 'Due in 9 days')),\n        tagCls: b.overdue ? 'tag bad' : (r ? 'tag neu' : (b.soon ? 'tag warn' : 'tag ok')),\n        canRenew: !b.overdue, mustPay: !!b.overdue,\n        renewLabel: r ? 'Renewed once' : 'Renew 14 days',\n        renew: () => { const d = Object.assign({}, s.renewed); d[b.id] = true; self.setState({ renewed: d }); }\n      };\n    });\n    const resBase = [\n      { id: 'dd', title: 'Designing Data-Intensive Applications', author: 'Martin Kleppmann', c: '#5A3E5E', note: 'Ready at the front desk until Sun 1 Nov', tag: 'Ready to collect', tagCls: 'tag ok' },\n      { id: 'co', title: 'Cosmos', author: 'Carl Sagan', c: '#2E3E63', note: 'You are 2nd in the queue · expected Sat 7 Nov', tag: 'Queue: 2 of 3', tagCls: 'tag warn' }\n    ];\n    const reservations = resBase.filter((r) => !s.cancelled[r.id]).map((r) => Object.assign({}, r, {\n      cancel: () => { const d = Object.assign({}, s.cancelled); d[r.id] = true; self.setState({ cancelled: d }); }\n    }));\n    const history = [\n      { title: 'Database System Concepts', author: 'Silberschatz, Korth, Sudarshan', c: '#3C5A5E', ret: '14 Oct · 4 days late', tag: 'Fine ₹20', tagCls: 'tag bad' },\n      { title: 'Sapiens', author: 'Yuval Noah Harari', c: '#6B4A2E', ret: '2 Oct · on time', tag: 'On time', tagCls: 'tag ok' },\n      { title: 'Pride and Prejudice', author: 'Jane Austen', c: '#7A3F4F', ret: '20 Sep · on time', tag: 'On time', tagCls: 'tag ok' },\n      { title: 'Wings of Fire', author: 'A. P. J. Abdul Kalam', c: '#3C5A4B', ret: '30 Aug · on time', tag: 'On time', tagCls: 'tag ok' }\n    ];\n    return {\n      tabs, loans, reservations, history,\n      showCurrent: s.tab === 'current', showRes: s.tab === 'res', showHist: s.tab === 'hist',\n      noRes: reservations.length === 0\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html><!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
