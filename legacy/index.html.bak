0px;padding:24px}\n.lbl{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#98A1AE;margin:0}\n.tag{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:999px;font:600 12px 'DM Sans',system-ui,sans-serif;white-space:nowrap}\n.tag.ok{background:#14301F;color:#8FE0A8}.tag.warn{background:#3A2D0F;color:#FFC247}.tag.bad{background:#3D1C1C;color:#FF9E9E}.tag.neu{background:#1D242E;color:#C9CFD8}\n.cv{aspect-ratio:2/3;border-radius:4px 8px 8px 4px;box-shadow:inset 7px 0 0 rgba(0,0,0,.28);padding:12px 10px 10px 18px;display:flex;flex-direction:column;justify-content:space-between;color:#F5EFE0;font:600 13px/1.15 'Fraunces',Georgia,serif;overflow:hidden}\n.cv small{font:500 10px 'DM Sans',system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#E9DFC8}\n.rw{display:flex;align-items:center;gap:16px;padding:16px 0;border-top:1px solid #232A33}\n.rw:first-of-type{border-top:0}\na.cl{color:inherit;text-decoration:none}\n.tile{display:flex;flex-direction:column;gap:6px;padding:22px 24px;border-radius:20px;background:#12171E;border:1px solid #232A33;text-decoration:none;color:inherit}\n.tile:hover{border-color:#566070}\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<div style=\"background:#0E1116;color:#F3EFE6;font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased\" data-canvas-width=\"1360\" data-canvas-height=\"1300\" data-document-role=\"page\" data-label=\"Member · Home\">\n  <dc-import name=\"Nav\" active=\"home\" hint-size=\"100%,76px\"><\u002Fdc-import>\n\n  <main style=\"max-width:1280px;margin:0 auto;padding:56px 40px 96px\">\n\n    <div style=\"display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px 40px\">\n      <div>\n        <p class=\"lbl\" style=\"color:#FFC247\">Library card LMN-2041 · Student plan<\u002Fp>\n        <h1 class=\"serif\" style=\"margin:12px 0 0;font-weight:400;font-size:clamp(40px,5vw,64px);line-height:1.05;letter-spacing:-0.025em\">Good evening, Riya.<\u002Fh1>\n      <\u002Fdiv>\n      <div style=\"display:flex;flex-wrap:wrap;gap:12px\">\n        <a class=\"btn pri\" href=\"Main.dc.html\">Book a seat<\u002Fa>\n        <a class=\"btn sec\" href=\"Catalogue.dc.html\">Search the catalogue<\u002Fa>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <!-- Fines alert -->\n    <div role=\"status\" style=\"margin-top:32px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 24px;padding:16px 20px;border-radius:16px;background:#3D1C1C;border:1px solid #5A2B2B\">\n      <p style=\"margin:0;font-size:15px;line-height:1.5;color:#FFD4D4\"><strong style=\"color:#fff\">1 book is overdue<\u002Fstrong> and ₹50 in fines is waiting. Clear it to keep renewing and booking seats.<\u002Fp>\n      <a class=\"btn sm\" href=\"Payments.dc.html\" style=\"background:#F3EFE6;color:#12161C\">Pay ₹50<\u002Fa>\n    <\u002Fdiv>\n\n    <!-- Tiles -->\n    <div style=\"margin-top:24px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:16px\">\n      <a class=\"tile\" href=\"Loans.dc.html\"><span class=\"lbl\">Books on loan<\u002Fspan><span class=\"serif\" style=\"font-size:44px;line-height:1\">3<\u002Fspan><span style=\"font-size:14px;color:#B4BBC6\">of 5 allowed on your plan<\u002Fspan><\u002Fa>\n      <a class=\"tile\" href=\"Loans.dc.html\"><span class=\"lbl\">Due in the next 7 days<\u002Fspan><span class=\"serif\" style=\"font-size:44px;line-height:1\">1<\u002Fspan><span style=\"font-size:14px;color:#B4BBC6\">Clean Code · Mon 2 Nov<\u002Fspan><\u002Fa>\n      <a class=\"tile\" href=\"Payments.dc.html\"><span class=\"lbl\">Fines due<\u002Fspan><span class=\"serif\" style=\"font-size:44px;line-height:1;color:#FF9E9E\">₹50<\u002Fspan><span style=\"font-size:14px;color:#B4BBC6\">2 items · tap to pay<\u002Fspan><\u002Fa>\n      <a class=\"tile\" href=\"Main.dc.html\"><span class=\"lbl\">Next seat<\u002Fspan><span class=\"serif\" style=\"font-size:44px;line-height:1\">Fri 30<\u002Fspan><span style=\"font-size:14px;color:#B4BBC6\">Table 3 · Seat 2 · 9:00 – 12:00<\u002Fspan><\u002Fa>\n    <\u002Fdiv>\n\n    <div style=\"margin-top:24px;display:flex;flex-wrap:wrap;gap:24px;align-items:flex-start\">\n\n      <!-- Borrowed -->\n      <section class=\"card\" aria-labelledby=\"b-h\" style=\"flex:999 1 560px;min-width:0\">\n        <div style=\"display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:8px\">\n          <h2 id=\"b-h\" class=\"serif\" style=\"margin:0;font-weight:400;font-size:28px\">Currently borrowed<\u002Fh2>\n          <a href=\"Loans.dc.html\" style=\"color:#F3EFE6;font-size:14px;font-weight:500;text-underline-offset:5px;min-height:44px;display:inline-flex;align-items:center\">All loans<\u002Fa>\n        <\u002Fdiv>\n        <sc-for list=\"{{borrowed}}\" as=\"b\" hint-placeholder-count=\"3\">\n          <div class=\"rw\">\n            <div class=\"cv\" style=\"width:52px;flex:0 0 52px;padding:8px 6px 6px 12px;background: {{b.c}}\"><span style=\"font-size:8px\"><\u002Fspan><\u002Fdiv>\n            <div style=\"flex:1 1 auto;min-width:0\">\n              <p style=\"margin:0;font-size:16px;font-weight:600;line-height:1.3\">{{b.title}}<\u002Fp>\n              <p style=\"margin:2px 0 0;font-size:14px;color:#B4BBC6\">{{b.author}}<\u002Fp>\n            <\u002Fdiv>\n            <span class=\"{{b.tagCls}}\">{{b.tag}}<\u002Fspan>\n            <a class=\"btn sec sm\" href=\"Loans.dc.html\">{{b.action}}<\u002Fa>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fsection>\n\n      <!-- Right column -->\n      <div style=\"flex:1 1 320px;min-width:0;display:flex;flex-direction:column;gap:24px\">\n        <section class=\"card\" aria-labelledby=\"s-h\">\n          <p class=\"lbl\">Your next seat<\u002Fp>\n          <h2 id=\"s-h\" class=\"serif\" style=\"margin:12px 0 4px;font-weight:400;font-size:30px;line-height:1.1\">Table 3 · Seat 2<\u002Fh2>\n          <p style=\"margin:0;font-size:15px;color:#B4BBC6\">Ground floor · Reading hall<br>Fri 30 Oct · 9:00 – 12:00<\u002Fp>\n          <div style=\"margin-top:20px;display:flex;flex-wrap:wrap;gap:10px\">\n            <a class=\"btn sec sm\" href=\"Main.dc.html\">View in 3D<\u002Fa>\n            <a class=\"btn sec sm\" href=\"Main.dc.html\">Change seat<\u002Fa>\n          <\u002Fdiv>\n        <\u002Fsection>\n        <section class=\"card\" aria-labelledby=\"r-h\">\n          <p class=\"lbl\">Reservation ready<\u002Fp>\n          <h2 id=\"r-h\" class=\"serif\" style=\"margin:12px 0 4px;font-weight:400;font-size:24px;line-height:1.2\">Designing Data-Intensive Applications<\u002Fh2>\n          <p style=\"margin:0;font-size:15px;color:#B4BBC6\">Held at the front desk until Sun 1 Nov.<\u002Fp>\n        <\u002Fsection>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <!-- Notices -->\n    <section id=\"notices\" class=\"card\" aria-labelledby=\"n-h\" style=\"margin-top:24px\">\n      <h2 id=\"n-h\" class=\"serif\" style=\"margin:0 0 8px;font-weight:400;font-size:28px\">Notices<\u002Fh2>\n      <sc-for list=\"{{notices}}\" as=\"n\" hint-placeholder-count=\"3\">\n        <div class=\"rw\" style=\"align-items:flex-start\">\n          <span class=\"{{n.tagCls}}\" style=\"margin-top:2px\">{{n.kind}}<\u002Fspan>\n          <p style=\"margin:0;flex:1 1 auto;min-width:0;font-size:15px;line-height:1.5;color:#E6E9EE\">{{n.text}}<\u002Fp>\n          <span style=\"font-size:13px;color:#98A1AE;white-space:nowrap\">{{n.when}}<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fsc-for>\n    <\u002Fsection>\n\n    <!-- Recommended -->\n    <section aria-labelledby=\"rec-h\" style=\"margin-top:56px\">\n      <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:20px\">\n        <h2 id=\"rec-h\" class=\"serif\" style=\"margin:0;font-weight:400;font-size:32px\">New on the shelves<\u002Fh2>\n        <a href=\"Catalogue.dc.html\" style=\"color:#F3EFE6;font-size:14px;font-weight:500;text-underline-offset:5px;min-height:44px;display:inline-flex;align-items:center\">Browse all<\u002Fa>\n      <\u002Fdiv>\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(min(170px,45%),1fr));gap:20px\">\n        <sc-for list=\"{{shelf}}\" as=\"s\" hint-placeholder-count=\"6\">\n          <a class=\"cl\" href=\"Catalogue.dc.html\" style=\"display:flex;flex-direction:column;gap:12px\">\n            <div class=\"cv\" style=\"background: {{s.c}}\"><small>{{s.cat}}<\u002Fsmall><span>{{s.title}}<\u002Fspan><\u002Fdiv>\n            <span style=\"font-size:14px;color:#B4BBC6\">{{s.author}}<\u002Fspan>\n          <\u002Fa>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fsection>\n  <\u002Fmain>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:1360,&quot;height&quot;:1300}}\">\nclass Component extends DCLogic {\n  renderVals() {\n    return {\n      borrowed: [\n        { title: 'Operating System Concepts', author: 'Silberschatz, Galvin, Gagne', c: '#7A3F33', tag: 'Overdue 6 days', tagCls: 'tag bad', action: 'Return' },\n        { title: 'Clean Code', author: 'Robert C. Martin', c: '#3E5C6B', tag: 'Due Mon 2 Nov', tagCls: 'tag warn', action: 'Renew' },\n        { title: 'Introduction to Algorithms', author: 'Cormen, Leiserson, Rivest, Stein', c: '#4A5B45', tag: 'Due Sat 7 Nov', tagCls: 'tag ok', action: 'Renew' }\n      ],\n      notices: [\n        { kind: 'Overdue', tagCls: 'tag bad', text: 'Operating System Concepts was due on Fri 23 Oct. Fines are ₹5 per day until it is returned.', when: 'Today' },\n        { kind: 'Ready', tagCls: 'tag ok', text: 'Designing Data-Intensive Applications is waiting for you at the front desk.', when: 'Yesterday' },\n        { kind: 'Seat', tagCls: 'tag neu', text: 'Reminder: you have Table 3 · Seat 2 booked tomorrow from 9:00.', when: 'Yesterday' }\n      ],\n      shelf: [\n        { title: 'The Pragmatic Programmer', author: 'Hunt, Thomas', cat: 'Computing', c: '#2F4A5C' },\n        { title: 'Sapiens', author: 'Yuval Noah Harari', cat: 'History', c: '#6B4A2E' },\n        { title: 'Atomic Habits', author: 'James Clear', cat: 'Self-help', c: '#5A3E5E' },\n        { title: 'A Brief History of Time', author: 'Stephen Hawking', cat: 'Science', c: '#26405A' },\n        { title: 'The Discovery of India', author: 'Jawaharlal Nehru', cat: 'History', c: '#7A4A2C' },\n        { title: 'Wings of Fire', author: 'A. P. J. Abdul Kalam', cat: 'Biography', c: '#3C5A4B' }\n      ]\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html><!DOCTYPE html>
