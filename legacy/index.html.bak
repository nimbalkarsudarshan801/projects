247;color:#1A1405}.btn.pri:hover{background:#FFD27A}\n.btn.sec{background:transparent;color:#F3EFE6;border-color:#3A424F}.btn.sec:hover{border-color:#8C96A5}\n.card{background:#12171E;border:1px solid #232A33;border-radius:20px;padding:24px}\n.lbl{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#98A1AE;margin:0}\n.tag{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:999px;font:600 12px 'DM Sans',system-ui,sans-serif;white-space:nowrap}\n.tag.ok{background:#14301F;color:#8FE0A8}.tag.warn{background:#3A2D0F;color:#FFC247}.tag.bad{background:#3D1C1C;color:#FF9E9E}.tag.neu{background:#1D242E;color:#C9CFD8}\n.cv{aspect-ratio:2/3;border-radius:4px 8px 8px 4px;box-shadow:inset 7px 0 0 rgba(0,0,0,.28);padding:12px 10px 10px 18px;display:flex;flex-direction:column;justify-content:space-between;color:#F5EFE0;font:600 14px/1.15 'Fraunces',Georgia,serif;overflow:hidden}\n.cv small{font:500 10px 'DM Sans',system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#E9DFC8}\n.chip{min-height:44px;padding:0 16px;border-radius:999px;border:1px solid #2F3743;background:#121720;color:#E6E9EE;font:500 14px 'DM Sans',system-ui,sans-serif;cursor:pointer}\n.chip:hover{border-color:#6B7585}\n.chip.on{background:#F3EFE6;color:#12161C;border-color:#F3EFE6}\n.inp{height:56px;width:100%;border-radius:16px;border:1px solid #2F3743;background:#12171E;color:#F3EFE6;padding:0 20px 0 52px;font:400 17px 'DM Sans',system-ui,sans-serif}\n.inp::placeholder{color:#8A93A1}\n.inp:focus{border-color:#FFC247;outline:none}\n.bk{display:flex;flex-direction:column;gap:12px;text-align:left;padding:14px;border-radius:16px;border:1px solid transparent;background:transparent;color:#F3EFE6;cursor:pointer;font-family:'DM Sans',system-ui,sans-serif}\n.bk:hover{background:#12171E}\n.bk.on{background:#12171E;border-color:#FFC247}\n.rw{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-top:1px solid #232A33;font-size:15px}\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<div style=\"background:#0E1116;color:#F3EFE6;font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased\" data-canvas-width=\"1360\" data-canvas-height=\"1500\" data-document-role=\"page\" data-label=\"Member · Catalogue\">\n  <dc-import name=\"Nav\" active=\"catalogue\" hint-size=\"100%,76px\"><\u002Fdc-import>\n\n  <main style=\"max-width:1280px;margin:0 auto;padding:56px 40px 96px\">\n    <h1 class=\"serif\" style=\"margin:0 0 28px;font-weight:400;font-size:clamp(40px,5vw,64px);line-height:1.05;letter-spacing:-0.025em\">Find your next read.<\u002Fh1>\n\n    <div style=\"position:relative\">\n      <label for=\"q\" style=\"position:absolute;left:-9999px\">Search by title, author or subject<\u002Flabel>\n      <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#98A1AE\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\" style=\"position:absolute;left:20px;top:17px\"><circle cx=\"11\" cy=\"11\" r=\"6.5\"><\u002Fcircle><path d=\"M16 16l4.5 4.5\"><\u002Fpath><\u002Fsvg>\n      <input id=\"q\" class=\"inp\" type=\"search\" placeholder=\"Search by title, author or subject\" value=\"{{q}}\" sc-camel-on-input=\"{{onQ}}\">\n    <\u002Fdiv>\n\n    <div role=\"group\" aria-label=\"Filters\" style=\"margin-top:20px;display:flex;flex-wrap:wrap;gap:8px\">\n      <sc-for list=\"{{cats}}\" as=\"c\" hint-placeholder-count=\"7\">\n        <button class=\"{{c.cls}}\" aria-pressed=\"{{c.pressed}}\" sc-camel-on-click=\"{{c.pick}}\">{{c.label}}<\u002Fbutton>\n      <\u002Fsc-for>\n      <span style=\"width:1px;background:#2F3743;margin:0 8px\"><\u002Fspan>\n      <button class=\"{{availCls}}\" aria-pressed=\"{{availPressed}}\" sc-camel-on-click=\"{{toggleAvail}}\">Available now<\u002Fbutton>\n    <\u002Fdiv>\n\n    <p aria-live=\"polite\" style=\"margin:28px 0 12px;font-size:14px;color:#98A1AE\">{{count}}<\u002Fp>\n\n    <div style=\"display:flex;flex-wrap:wrap;gap:32px;align-items:flex-start\">\n      <div style=\"flex:999 1 560px;min-width:0\">\n        <sc-if value=\"{{hasResults}}\" hint-placeholder-val=\"{{ true }}\">\n          <div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(min(180px,45%),1fr));gap:8px\">\n            <sc-for list=\"{{books}}\" as=\"b\" hint-placeholder-count=\"8\">\n              <button class=\"{{b.cls}}\" sc-camel-on-click=\"{{b.pick}}\" aria-pressed=\"{{b.pressed}}\">\n                <div class=\"cv\" style=\"background: {{b.c}}\"><small>{{b.cat}}<\u002Fsmall><span>{{b.title}}<\u002Fspan><\u002Fdiv>\n                <span style=\"font-size:14px;line-height:1.35;color:#B4BBC6\">{{b.author}}<\u002Fspan>\n                <span class=\"{{b.tagCls}}\">{{b.status}}<\u002Fspan>\n              <\u002Fbutton>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n        <sc-if value=\"{{noResults}}\" hint-placeholder-val=\"{{ false }}\">\n          <div class=\"card\" style=\"text-align:center;padding:56px 24px\">\n            <h2 class=\"serif\" style=\"margin:0 0 8px;font-weight:400;font-size:28px\">Nothing matches that<\u002Fh2>\n            <p style=\"margin:0 0 20px;color:#B4BBC6;font-size:15px\">Try a shorter search, or clear the filters.<\u002Fp>\n            <button class=\"btn sec\" sc-camel-on-click=\"{{clear}}\">Clear filters<\u002Fbutton>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n      <\u002Fdiv>\n\n      <!-- Detail -->\n      <aside aria-label=\"Book details\" aria-live=\"polite\" class=\"card\" style=\"flex:1 1 340px;min-width:0\">\n        <sc-if value=\"{{noSel}}\" hint-placeholder-val=\"{{ true }}\">\n          <p class=\"lbl\">Details<\u002Fp>\n          <p style=\"margin:12px 0 0;font-size:15px;line-height:1.55;color:#B4BBC6\">Select a book to see where it is shelved, how many copies are free, and to borrow or reserve it.<\u002Fp>\n        <\u002Fsc-if>\n        <sc-if value=\"{{hasSel}}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"display:flex;gap:20px;align-items:flex-start\">\n            <div class=\"cv\" style=\"width:110px;flex:0 0 110px;background: {{sel.c}}\"><small>{{sel.cat}}<\u002Fsmall><span>{{sel.title}}<\u002Fspan><\u002Fdiv>\n            <div style=\"min-width:0\">\n              <h2 class=\"serif\" style=\"margin:0;font-weight:400;font-size:28px;line-height:1.1\">{{sel.title}}<\u002Fh2>\n              <p style=\"margin:8px 0 12px;font-size:15px;color:#B4BBC6\">{{sel.author}}<\u002Fp>\n              <span class=\"{{sel.tagCls}}\">{{sel.status}}<\u002Fspan>\n            <\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"margin-top:20px\">\n            <div class=\"rw\"><span style=\"color:#98A1AE\">Category<\u002Fspan><span>{{sel.cat}}<\u002Fspan><\u002Fdiv>\n            <div class=\"rw\"><span style=\"color:#98A1AE\">Call number<\u002Fspan><span>{{sel.call}}<\u002Fspan><\u002Fdiv>\n            <div class=\"rw\"><span style=\"color:#98A1AE\">Shelf<\u002Fspan><span style=\"text-align:right\">{{sel.shelf}}<\u002Fspan><\u002Fdiv>\n            <div class=\"rw\"><span style=\"color:#98A1AE\">Copies free<\u002Fspan><span>{{sel.free}} of {{sel.total}}<\u002Fspan><\u002Fdiv>\n          <\u002Fdiv>\n          <sc-if value=\"{{showActions}}\" hint-placeholder-val=\"{{ true }}\">\n            <div style=\"margin-top:20px;display:flex;flex-direction:column;gap:10px\">\n              <button class=\"btn pri\" sc-camel-on-click=\"{{act}}\" style=\"width:100%\">{{sel.actionLabel}}<\u002Fbutton>\n              <button class=\"btn sec\" sc-camel-on-click=\"{{save}}\" style=\"width:100%\">{{saveLabel}}<\u002Fbutton>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n          <sc-if value=\"{{showDone}}\" hint-placeholder-val=\"{{ false }}\">\n            <div role=\"status\" style=\"margin-top:20px;padding:16px;border-radius:14px;background:#14301F;color:#BDEFCB;font-size:15px;line-height:1.5\">\n              <strong style=\"color:#fff\">{{doneTitle}}<\u002Fstrong><br>{{doneText}}\n            <\u002Fdiv>\n            <a class=\"btn sec\" href=\"Loans.dc.html\" style=\"width:100%;margin-top:10px\">Go to my loans<\u002Fa>\n          <\u002Fsc-if>\n        <\u002Fsc-if>\n      <\u002Faside>\n    <\u002Fdiv>\n  <\u002Fmain>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:1360,&quot;height&quot;:1500}}\">\nclass Component extends DCLogic {\n  constructor(props) {\n    super(props);\n    this.state = { q: '', cat: 'All', avail: false, sel: null, done: {}, saved: {} };\n  }\n  books() {\n    return [\n      { id: 1, title: 'Introduction to Algorithms', author: 'Cormen, Leiserson, Rivest, Stein', cat: 'Computing', call: '005.1 COR', shelf: 'Ground floor · Stack C4', free: 2, total: 3, c: '#4A5B45', back: '' },\n      { id: 2, title: 'Clean Code', author: 'Robert C. Martin', cat: 'Computing', call: '005.1 MAR', shelf: 'Ground floor · Stack C4', free: 0, total: 2, c: '#3E5C6B', back: 'Mon 2 Nov' },\n      { id: 3, title: 'Designing Data-Intensive Applications', author: 'Martin Kleppmann', cat: 'Computing', call: '005.7 KLE', shelf: 'Ground floor · Stack C5', free: 1, total: 2, c: '#5A3E5E', back: '' },\n      { id: 4, title: 'The Pragmatic Programmer', author: 'Hunt, Thomas', cat: 'Computing', call: '005.1 HUN', shelf: 'Ground floor · Stack C4', free: 1, total: 1, c: '#2F4A5C', back: '' },\n      { id: 5, title: 'A Brief History of Time', author: 'Stephen Hawking', cat: 'Science', call: '523.1 HAW', shelf: 'First floor · Stack S2', free: 2, total: 2, c: '#26405A', back: '' },\n      { id: 6, title: 'Cosmos', author: 'Carl Sagan', cat: 'Science', call: '520 SAG', shelf: 'First floor · Stack S2', free: 0, total: 1, c: '#2E3E63', back: 'Sat 7 Nov' },\n      { id: 7, title: 'Sapiens', author: 'Yuval Noah Harari', cat: 'History', call: '909 HAR', shelf: 'First floor · Stack H1', free: 3, total: 4, c: '#6B4A2E', back: '' },\n      { id: 8, title: 'The Discovery of India', author: 'Jawaharlal Nehru', cat: 'History', call: '954 NEH', shelf: 'First floor · Stack H3', free: 1, total: 2, c: '#7A4A2C', back: '' },\n      { id: 9, title: 'Pride and Prejudice', author: 'Jane Austen', cat: 'Fiction', call: 'FIC AUS', shelf: 'Ground floor · Stack F1', free: 2, total: 3, c: '#7A3F4F', back: '' },\n      { id: 10, title: 'The Guide', author: 'R. K. Narayan', cat: 'Fiction', call: 'FIC NAR', shelf: 'Ground floor · Stack F2', free: 0, total: 1, c: '#6C5B2E', back: 'Thu 5 Nov' },\n      { id: 11, title: 'Wings of Fire', author: 'A. P. J. Abdul Kalam', cat: 'Biography', call: '920 KAL', shelf: 'First floor · Stack B1', free: 2, total: 2, c: '#3C5A4B', back: '' },\n      { id: 12, title: 'Atomic Habits', author: 'James Clear', cat: 'Self-help', call: '158 CLE', shelf: 'First floor · Stack P1', free: 1, total: 3, c: '#5E4A3E', back: '' }\n    ];\n  }\n  renderVals() {\n    const s = this.state;\n    const self = this;\n    const catNames = ['All', 'Computing', 'Science', 'History', 'Fiction', 'Biography', 'Self-help'];\n    const q = s.q.trim().toLowerCase();\n    const all = this.books().map((b) => {\n      const isFree = b.free > 0;\n      const act = s.done[b.id];\n      return Object.assign({}, b, {\n        status: isFree ? 'Available · ' + b.free + ' free' : 'On loan · back ' + b.back,\n        tagCls: isFree ? 'tag ok' : 'tag warn',\n        actionLabel: isFree ? 'Borrow this book' : 'Reserve — join the queue'\n      });\n    });\n    const list = all.filter((b) => (s.cat === 'All' || b.cat === s.cat) && (!s.avail || b.free > 0) && (!q || (b.title + ' ' + b.author + ' ' + b.cat).toLowerCase().indexOf(q) >= 0));\n    const books = list.map((b) => ({\n      title: b.title, author: b.author, cat: b.cat, c: b.c, status: b.status, tagCls: b.tagCls,\n      cls: s.sel === b.id ? 'bk on' : 'bk',\n      pressed: s.sel === b.id ? 'true' : 'false',\n      pick: () => self.setState({ sel: b.id })\n    }));\n    const selBook = all.find((b) => b.id === s.sel) || null;\n    const done = selBook ? s.done[selBook.id] : null;\n    return {\n      q: s.q,\n      onQ: (e) => self.setState({ q: e.target.value }),\n      cats: catNames.map((c) => ({ label: c, cls: s.cat === c ? 'chip on' : 'chip', pressed: s.cat === c ? 'true' : 'false', pick: () => self.setState({ cat: c }) })),\n      availCls: s.avail ? 'chip on' : 'chip',\n      availPressed: s.avail ? 'true' : 'false',\n      toggleAvail: () => self.setState({ avail: !s.avail }),\n      count: list.length + (list.length === 1 ? ' book' : ' books') + (s.cat === 'All' ? '' : ' in ' + s.cat),\n      books, hasResults: list.length > 0, noResults: list.length === 0,\n      clear: () => self.setState({ q: '', cat: 'All', avail: false }),\n      noSel: !selBook, hasSel: !!selBook,\n      sel: selBook || { c: '#333', cat: '', title: '', author: '', status: '', tagCls: 'tag neu', call: '', shelf: '', free: 0, total: 0, actionLabel: '' },\n      showActions: !!selBook && !done,\n      showDone: !!selBook && !!done,\n      doneTitle: selBook && selBook.free > 0 ? 'Borrowed' : 'Reserved',\n      doneText: selBook && selBook.free > 0 ? 'Collect it from the front desk. Due Thu 12 Nov.' : 'You are next in the queue. We will notify you when it is ready.',\n      act: () => { const d = Object.assign({}, s.done); d[s.sel] = true; self.setState({ done: d }); },\n      saveLabel: selBook && s.saved[selBook.id] ? 'Saved to reading list' : 'Save to reading list',\n      save: () => { const d = Object.assign({}, s.saved); d[s.sel] = !d[s.sel]; self.setState({ saved: d }); }\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html><!DOCTYPE html>
