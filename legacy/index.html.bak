 U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(https://fonts.gstatic.com/s/fraunces/v38/6NU78FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c2Wa0KxCBTeO-U.woff2) format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(https://fonts.gstatic.com/s/fraunces/v38/6NU78FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c2Wa0KxCFTeO-U.woff2) format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Fraunces';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"079a1e9f-d39b-4c88-a475-417e0a2a79c3\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\nbody{margin:0;background:#0E1116}\n*{box-sizing:border-box}\n:focus-visible{outline:2px solid #FFC247;outline-offset:3px}\n.serif{font-family:'Fraunces',Georgia,serif}\n.nl{color:#C9CFD8;text-decoration:none;font-size:15px;padding:12px 4px}\n.nl:hover{color:#fff}\n.nl.cur{color:#FFC247}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 26px;border-radius:999px;font:600 15px 'DM Sans',system-ui,sans-serif;cursor:pointer;text-decoration:none;border:1px solid transparent}\n.btn.pri{background:#FFC247;color:#1A1405}\n.btn.pri:hover{background:#FFD27A}\n.btn.sec{background:transparent;color:#F3EFE6;border-color:#3A424F}\n.btn.sec:hover{border-color:#8C96A5}\n.btn.sm{min-height:44px;padding:0 18px;font-size:14px;width:100%}\n.lnk{color:#F3EFE6;font-weight:500;font-size:15px;text-decoration:underline;text-underline-offset:5px;text-decoration-color:#566070;min-height:44px;display:inline-flex;align-items:center}\n.lnk:hover{text-decoration-color:#FFC247}\n.chip{min-height:48px;min-width:48px;padding:6px 14px;border-radius:12px;border:1px solid #2F3743;background:#121720;color:#E6E9EE;font:500 14px 'DM Sans',system-ui,sans-serif;cursor:pointer;text-align:left;display:flex;flex-direction:column;justify-content:center;gap:1px}\n.chip small{font-size:12px;font-weight:400;color:#A3ABB8}\n.chip:hover{border-color:#6B7585}\n.chip.on{background:#F3EFE6;color:#12161C;border-color:#F3EFE6}\n.chip.on small{color:#4A4F57}\n.hud{min-height:44px;min-width:44px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 12px;border-radius:12px;border:1px solid #2F3743;background:#12171E;color:#E6E9EE;font:500 14px 'DM Sans',system-ui,sans-serif;cursor:pointer}\n.hud:hover{background:#1B222B;border-color:#6B7585}\n.hud.on{background:#F3EFE6;color:#12161C;border-color:#F3EFE6}\n\n/* ---------- 3D room ---------- */\n.stage{position:relative;height:660px;border-radius:24px;border:1px solid #232A33;background:#0A0D11;background-image:radial-gradient(#1A2029 1px,transparent 1px);background-size:22px 22px;overflow:hidden}\n.view{position:absolute;left:0;top:0;right:0;bottom:0;perspective:2200px;perspective-origin:50% 30%}\n.sw{position:absolute;left:50%;top:52%;width:0;height:0;transform-style:preserve-3d;scale:.84}\n.scene{position:absolute;left:0;top:0;width:0;height:0;transform-style:preserve-3d;transition:transform .85s cubic-bezier(.2,.7,.2,1)}\n.box{position:absolute;left:0;top:0;width:0;height:0;transform-style:preserve-3d}\n.box>.f{position:absolute;left:0;top:0;margin:0;padding:0;border:0;background:var(--c);display:block}\n.box>.f.fr,.box>.f.bk{width:var(--w);height:var(--h);margin:calc(var(--h) / -2) 0 0 calc(var(--w) / -2);background:color-mix(in oklab,var(--c),#000 30%)}\n.box>.f.fr{transform:translate3d(0,calc(var(--d) / 2),calc(var(--h) / 2)) rotateX(90deg)}\n.box>.f.bk{transform:translate3d(0,calc(var(--d) / -2),calc(var(--h) / 2)) rotateX(90deg)}\n.box>.f.rt,.box>.f.lf{width:var(--d);height:var(--h);margin:calc(var(--h) / -2) 0 0 calc(var(--d) / -2);background:color-mix(in oklab,var(--c),#000 46%)}\n.box>.f.rt{transform:translate3d(calc(var(--w) / 2),0,calc(var(--h) / 2)) rotateZ(90deg) rotateX(90deg)}\n.box>.f.lf{transform:translate3d(calc(var(--w) / -2),0,calc(var(--h) / 2)) rotateZ(90deg) rotateX(90deg)}\n.box>.f.t{width:var(--w);height:var(--d);margin:calc(var(--d) / -2) 0 0 calc(var(--w) / -2);transform:translateZ(var(--h));background:color-mix(in oklab,var(--c),#fff 10%)}\n\n.floor{position:absolute;left:-380px;top:-260px;width:760px;height:520px;border-radius:6px;background-color:#171C24;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:40px 40px;border:1px solid #2A313C}\n.fl{position:absolute;left:0;right:0;text-align:center;font:600 11px 'DM Sans',system-ui,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#98A1AE}\n.slab{--w:760px;--d:520px;--h:12px;--c:#10141A;transform:translate3d(0,0,-12px)}\n.slab>.f.t{display:none}\n.shelf{--w:24px;--d:430px;--h:46px;--c:#3D3027}\n.shelf>.f.rt,.shelf>.f.lf{background:linear-gradient(#1A1410 0 3px,transparent 3px 21px,#1A1410 21px 25px,transparent 25px 43px,#1A1410 43px),repeating-linear-gradient(90deg,#8A4B3A 0 7px,#C9A35A 7px 12px,#4D6B73 12px 21px,#6E5A7E 21px 26px,#A9573F 26px 34px,#D8CDB3 34px 38px,#3F5A49 38px 47px)}\n.tbl{--w:150px;--d:56px;--h:15px;--c:#6A4F3D}\n.cd{--w:44px;--d:28px;--h:14px;--c:#6A4F3D}\n.cp{--w:44px;--d:4px;--h:34px;--c:#3A4250;transform:translate3d(0,-12px,14px)}\n.seat{--w:28px;--d:28px;--h:10px;transition:translate .25s}\n.seat.free{--c:#7FB2C4}\n.seat.taken{--c:#2B313B}\n.seat.sel{--c:#FFC247;translate:0 0 9px}\n.seat.free:has(.top:hover){translate:0 0 5px}\n.sb{--w:28px;--d:4px;--h:20px;transform:translate3d(0,12px,10px)}\n.seat .top{border-radius:7px;cursor:pointer}\n.seat.taken .top{cursor:not-allowed}\n.seat.free .top:hover{background:color-mix(in oklab,var(--c),#fff 30%)}\n.seat .top:focus-visible{outline:2px solid #FFC247;outline-offset:2px}\n.sh{position:absolute;left:-18px;top:-18px;width:36px;height:36px;border-radius:9px;background:rgba(0,0,0,.5);filter:blur(5px);transform:translateZ(.5px)}\n.tbl .sh,.cd .sh{left:-84px;top:-38px;width:168px;height:76px}\n.cd .sh{left:-28px;top:-22px;width:56px;height:44px}\n.seat.sel .sh{transform:translateZ(-8.5px)}\n.ring{display:none;position:absolute;left:-30px;top:-30px;width:60px;height:60px;border:2px solid #FFC247;border-radius:50%;box-shadow:0 0 18px rgba(255,194,71,.55);transform:translateZ(-8.5px)}\n.seat.sel .ring{display:block;animation:pulse 1.8s ease-in-out infinite}\n@keyframes pulse{0%,100%{transform:translateZ(-8.5px) scale(.85)}50%{transform:translateZ(-8.5px) scale(1.12)}}\n@media (prefers-reduced-motion:reduce){.seat.sel .ring{animation:none}.scene,.seat{transition:none}}\n\n@media (max-width:1180px){.sw{scale:.7}}\n@media (max-width:1010px){.sw{scale:.78}}\n@media (max-width:760px){.sw{scale:.6}.stage{height:540px}}\n@media (max-width:560px){.sw{scale:.4}.stage{height:440px}}\n@media (max-width:420px){.sw{scale:.36}}\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<div style=\"background:#0E1116;color:#F3EFE6;font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased\" data-canvas-width=\"1360\" data-canvas-height=\"2000\" data-document-role=\"page\" data-label=\"Member · Book a seat (3D)\">\n\n  <!-- Nav -->\n  <dc-import name=\"Nav\" active=\"seats\" hint-size=\"100%,76px\"><\u002Fdc-import>\n\n  <!-- Hero -->\n  <section id=\"top\" style=\"max-width:1280px;margin:0 auto;padding:80px 40px 72px;display:flex;flex-wrap:wrap;align-items:flex-end;gap:48px 80px\">\n    <div style=\"flex:1 1 560px;min-width:0\">\n      <p style=\"margin:0 0 20px;font-size:13px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#FFC247\">Library seat booking<\u002Fp>\n      <h1 class=\"serif\" style=\"margin:0;font-weight:400;font-size:clamp(44px,5.6vw,76px);line-height:1.02;letter-spacing:-0.025em;text-wrap:balance\">Pick your seat before you walk in.<\u002Fh1>\n      <p style=\"margin:28px 0 0;max-width:500px;font-size:18px;line-height:1.6;color:#B4BBC6;text-wrap:pretty\">See the whole reading hall in 3D, turn it around, and reserve the exact chair you want for the day and time that suits you.<\u002Fp>\n      <div style=\"margin-top:36px;display:flex;flex-wrap:wrap;align-items:center;gap:12px 28px\">\n        <a class=\"btn pri\" href=\"#book\">Choose a seat<\u002Fa>\n        <a class=\"lnk\" href=\"Catalogue.dc.html\">Browse the catalogue<\u002Fa>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <ol style=\"flex:1 1 320px;min-width:0;margin:0;padding:0;list-style:none;border-top:1px solid #2A313C\">\n      <li style=\"display:flex;gap:24px;align-items:baseline;padding:22px 0;border-bottom:1px solid #2A313C\">\n        <span class=\"serif\" style=\"font-size:28px;color:#FFC247;min-width:40px\">01<\u002Fspan>\n        <span style=\"font-size:17px;line-height:1.45;color:#E6E9EE\">Choose the floor, the day and a time slot.<\u002Fspan>\n      <\u002Fli>\n      <li style=\"display:flex;gap:24px;align-items:baseline;padding:22px 0;border-bottom:1px solid #2A313C\">\n        <span class=\"serif\" style=\"font-size:28px;color:#FFC247;min-width:40px\">02<\u002Fspan>\n        <span style=\"font-size:17px;line-height:1.45;color:#E6E9EE\">Turn the room and tap any free seat.<\u002Fspan>\n      <\u002Fli>\n      <li style=\"display:flex;gap:24px;align-items:baseline;padding:22px 0;border-bottom:1px solid #2A313C\">\n        <span class=\"serif\" style=\"font-size:28px;color:#FFC247;min-width:40px\">03<\u002Fspan>\n        <span style=\"font-size:17px;line-height:1.45;color:#E6E9EE\">Confirm. The seat is yours for the slot.<\u002Fspan>\n      <\u002Fli>\n    <\u002Fol>\n  <\u002Fsection>\n\n  <!-- Booking -->\n  <section id=\"book\" aria-labelledby=\"book-h\" style=\"max-width:1280px;margin:0 auto;padding:16px 40px 96px\">\n    <div style=\"display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:16px 32px;margin-bottom:28px\">\n      <div>\n        <p style=\"margin:0 0 10px;font-size:13px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#98A1AE\">{{levelName}}<\u002Fp>\n        <h2 id=\"book-h\" class=\"serif\" style=\"margin:0;font-weight:400;font-size:clamp(34px,4vw,52px);line-height:1.05;letter-spacing:-0.02em\">Book a seat<\u002Fh2>\n      <\u002Fdiv>\n      <p aria-live=\"polite\" style=\"margin:0;display:flex;align-items:baseline;gap:10px;color:#B4BBC6;font-size:15px\">\n        <span class=\"serif\" style=\"font-size:40px;line-height:1;color:#F3EFE6\">{{freeCount}}<\u002Fspan>\n        <span>of {{total}} seats free in this slot<\u002Fspan>\n      <\u002Fp>\n    <\u002Fdiv>\n\n    <!-- Filters -->\n    <div style=\"display:flex;flex-wrap:wrap;gap:20px 36px;padding:20px 24px;border-radius:20px;background:#12171E;border:1px solid #232A33;margin-bottom:24px\">\n      <div role=\"group\" aria-label=\"Floor\" style=\"display:flex;flex-direction:column;gap:10px\">\n        <span style=\"font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#98A1AE\">Floor<\u002Fspan>\n        <div style=\"display:flex;flex-wrap:wrap;gap:8px\">\n          <sc-for list=\"{{levels}}\" as=\"lv\" hint-placeholder-count=\"2\">\n            <button class=\"{{lv.cls}}\" aria-pressed=\"{{lv.pressed}}\" sc-camel-on-click=\"{{lv.pick}}\"><span>{{lv.name}}<\u002Fspan><small>{{lv.sub}}<\u002Fsmall><\u002Fbutton>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div role=\"group\" aria-label=\"Day\" style=\"display:flex;flex-direction:column;gap:10px\">\n        <span style=\"font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#98A1AE\">Day<\u002Fspan>\n        <div style=\"display:flex;flex-wrap:wrap;gap:8px\">\n          <sc-for list=\"{{days}}\" as=\"d\" hint-placeholder-count=\"5\">\n            <button class=\"{{d.cls}}\" aria-pressed=\"{{d.pressed}}\" sc-camel-on-click=\"{{d.pick}}\"><span>{{d.wd}}<\u002Fspan><small>{{d.num}} {{d.mon}}<\u002Fsmall><\u002Fbutton>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div role=\"group\" aria-label=\"Time slot\" style=\"display:flex;flex-direction:column;gap:10px\">\n        <span style=\"font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#98A1AE\">Time slot<\u002Fspan>\n        <div style=\"display:flex;flex-wrap:wrap;gap:8px\">\n          <sc-for list=\"{{slots}}\" as=\"sl\" hint-placeholder-count=\"4\">\n            <button class=\"{{sl.cls}}\" aria-pressed=\"{{sl.pressed}}\" sc-camel-on-click=\"{{sl.pick}}\"><span>{{sl.label}}<\u002Fspan><\u002Fbutton>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <div style=\"display:flex;flex-wrap:wrap;gap:24px;align-items:stretch\">\n\n      <!-- 3D stage -->\n      <div class=\"stage\" style=\"flex:999 1 560px;min-width:0\">\n        <div class=\"view\" role=\"group\" aria-label=\"3D map of the reading hall. Seats are buttons.\">\n          <div class=\"sw\">\n            <div class=\"scene\" style=\"transform: {{sceneTf}}\">\n\n              <div class=\"box slab\"><i class=\"f fr\"><\u002Fi><i class=\"f bk\"><\u002Fi><i class=\"f lf\"><\u002Fi><i class=\"f rt\"><\u002Fi><i class=\"f t\"><\u002Fi><\u002Fdiv>\n              <div class=\"floor\">\n                <span class=\"fl\" style=\"top:276px\">{{levelName}}<\u002Fspan>\n                <span class=\"fl\" style=\"bottom:10px\">Entrance<\u002Fspan>\n              <\u002Fdiv>\n\n              <div class=\"box shelf\" style=\"transform: translate3d(-352px,0,0)\"><i class=\"f fr\"><\u002Fi><i class=\"f bk\"><\u002Fi><i class=\"f lf\"><\u002Fi><i class=\"f rt\"><\u002Fi><i class=\"f t\"><\u002Fi><\u002Fdiv>\n              <div class=\"box shelf\" style=\"transform: translate3d(352px,0,0)\"><i class=\"f fr\"><\u002Fi><i class=\"f bk\"><\u002Fi><i class=\"f lf\"><\u002Fi><i class=\"f rt\"><\u002Fi><i class=\"f t\"><\u002Fi><\u002Fdiv>\n\n              <sc-for list=\"{{tables}}\" as=\"tb\" hint-placeholder-count=\"6\">\n                <div class=\"box tbl\" style=\"transform: {{tb.tf}}\"><i class=\"sh\"><\u002Fi><i class=\"f fr\"><\u002Fi><i class=\"f bk\"><\u002Fi><i class=\"f lf\"><\u002Fi><i class=\"f rt\"><\u002Fi><i class=\"f t\"><\u002Fi><\u002Fdiv>\n              <\u002Fsc-for>\n\n              <sc-for list=\"{{carrels}}\" as=\"cr\" hint-placeholder-count=\"8\">\n                <div class=\"box cd\" style=\"transform: {{cr.tf}}\"><i class=\"sh\"><\u002Fi><i class=\"f fr\"><\u002Fi><i class=\"f bk\"><\u002Fi><i class=\"f lf\"><\u002Fi><i class=\"f rt\"><\u002Fi><i class=\"f t\"><\u002Fi>\n                  <div class=\"box cp\"><i class=\"f fr\"><\u002Fi><i class=\"f bk\"><\u002Fi><i class=\"f lf\"><\u002Fi><i class=\"f rt\"><\u002Fi><i class=\"f t\"><\u002Fi><\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n\n              <sc-for list=\"{{seats}}\" as=\"seat\" hint-placeholder-count=\"44\">\n                <div class=\"seat box {{seat.state}}\" style=\"transform: {{seat.tf}}\">\n                  <i class=\"sh\"><\u002Fi><i class=\"ring\"><\u002Fi>\n                  <button class=\"f t top\" aria-label=\"{{seat.aria}}\" title=\"{{seat.aria}}\" disabled=\"{{seat.taken}}\" sc-camel-on-click=\"{{seat.pick}}\"><\u002Fbutton>\n                  <i class=\"f fr\"><\u002Fi><i class=\"f bk\"><\u002Fi><i class=\"f lf\"><\u002Fi><i class=\"f rt\"><\u002Fi>\n                  <div class=\"box sb\"><i class=\"f fr\"><\u002Fi><i class=\"f bk\"><\u002Fi><i class=\"f lf\"><\u002Fi><i class=\"f rt\"><\u002Fi><i class=\"f t\"><\u002Fi><\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n\n        <!-- Legend -->\n        <div style=\"position:absolute;left:16px;top:16px;z-index:5;display:flex;flex-wrap:wrap;gap:8px 18px;padding:10px 14px;border-radius:12px;background:#12171E;border:1px solid #2F3743;font-size:13px;color:#E6E9EE\">\n          <span style=\"display:inline-flex;align-items:center;gap:8px\"><i style=\"display:block;width:14px;height:14px;border-radius:4px;background:#7FB2C4\"><\u002Fi>Free<\u002Fspan>\n          <span style=\"display:inline-flex;align-items:center;gap:8px\"><i style=\"display:block;width:14px;height:14px;border-radius:4px;background:#2B313B;border:1px solid #6B7585\"><\u002Fi>Taken<\u002Fspan>\n          <span style=\"display:inline-flex;align-items:center;gap:8px\"><i style=\"display:block;width:14px;height:14px;border-radius:4px;background:#FFC247\"><\u002Fi>Your pick<\u002Fspan>\n        <\u002Fdiv>\n\n        <!-- View controls -->\n        <div style=\"position:absolute;left:16px;right:16px;bottom:16px;z-index:5;display:flex;flex-wrap:wrap;justify-content:center;gap:8px\">\n          <sc-for list=\"{{views}}\" as=\"vw\" hint-placeholder-count=\"3\">\n            <button class=\"{{vw.cls}}\" aria-pressed=\"{{vw.pressed}}\" sc-camel-on-click=\"{{vw.pick}}\">{{vw.label}}<\u002Fbutton>\n          <\u002Fsc-for>\n          <button class=\"hud\" aria-label=\"Rotate room left\" sc-camel-on-click=\"{{rotL}}\"><svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12a8 8 0 1 0 2.6-5.9\"><\u002Fpath><path d=\"M4 4v4h4\"><\u002Fpath><\u002Fsvg><\u002Fbutton>\n          <button class=\"hud\" aria-label=\"Rotate room right\" sc-camel-on-click=\"{{rotR}}\"><svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><g transform=\"matrix(-1 0 0 1 24 0)\"><path d=\"M4 12a8 8 0 1 0 2.6-5.9\"><\u002Fpath><path d=\"M4 4v4h4\"><\u002Fpath><\u002Fg><\u002Fsvg><\u002Fbutton>\n          <button class=\"hud\" aria-label=\"Zoom out\" sc-camel-on-click=\"{{zoomOut}}\"><svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 12h12\"><\u002Fpath><\u002Fsvg><\u002Fbutton>\n          <button class=\"hud\" aria-label=\"Zoom in\" sc-camel-on-click=\"{{zoomIn}}\"><svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 12h12M12 6v12\"><\u002Fpath><\u002Fsvg><\u002Fbutton>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <!-- Summary -->\n      <aside aria-label=\"Your seat\" aria-live=\"polite\" style=\"flex:1 1 300px;max-width:100%;min-width:0;display:flex;flex-direction:column;padding:28px;border-radius:24px;background:#12171E;border:1px solid #232A33\">\n        <p style=\"margin:0 0 20px;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#98A1AE\">Your seat<\u002Fp>\n\n        <sc-if value=\"{{noSel}}\" hint-placeholder-val=\"{{ true }}\">\n          <div style=\"display:flex;flex-direction:column;gap:16px;align-items:flex-start\">\n            <svg width=\"44\" height=\"44\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#98A1AE\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 11V7a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v4\"><\u002Fpath><path d=\"M4 13a2 2 0 0 1 4 0v3h8v-3a2 2 0 0 1 4 0v5H4z\"><\u002Fpath><path d=\"M7 18v2M17 18v2\"><\u002Fpath><\u002Fsvg>\n            <h3 class=\"serif\" style=\"margin:0;font-weight:400;font-size:28px;line-height:1.15\">No seat chosen yet<\u002Fh3>\n            <p style=\"margin:0;font-size:15px;line-height:1.55;color:#B4BBC6;text-wrap:pretty\">Tap any free seat in the room, or let us pick the first one that is open.<\u002Fp>\n            <button class=\"btn sec sm\" sc-camel-on-click=\"{{pickForMe}}\">Pick one for me<\u002Fbutton>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n\n        <sc-if value=\"{{confirmable}}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"display:flex;flex-direction:column;gap:20px\">\n            <div>\n              <h3 class=\"serif\" style=\"margin:0;font-weight:400;font-size:34px;line-height:1.1;letter-spacing:-0.01em\">{{selLabel}}<\u002Fh3>\n              <p style=\"margin:6px 0 0;font-size:15px;color:#FFC247\">{{selKind}}<\u002Fp>\n            <\u002Fdiv>\n            <dl style=\"margin:0;display:grid;grid-template-columns:auto 1fr;gap:12px 20px;font-size:15px;border-top:1px solid #2A313C;padding-top:20px\">\n              <dt style=\"color:#98A1AE\">Floor<\u002Fdt><dd style=\"margin:0;text-align:right\">{{selLevel}}<\u002Fdd>\n              <dt style=\"color:#98A1AE\">Day<\u002Fdt><dd style=\"margin:0;text-align:right\">{{selDay}}<\u002Fdd>\n              <dt style=\"color:#98A1AE\">Time<\u002Fdt><dd style=\"margin:0;text-align:right\">{{selTime}}<\u002Fdd>\n            <\u002Fdl>\n            <button class=\"btn pri\" sc-camel-on-click=\"{{confirm}}\" style=\"width:100%\">Confirm booking<\u002Fbutton>\n            <button class=\"btn sec sm\" sc-camel-on-click=\"{{clearSel}}\">Choose a different seat<\u002Fbutton>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n\n        <sc-if value=\"{{done}}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"display:flex;flex-direction:column;gap:20px\">\n            <div style=\"display:flex;align-items:center;gap:14px\">\n              <span style=\"display:inline-flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:50%;background:#FFC247;color:#1A1405\">\n                <svg width=\"26\" height=\"26\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"><\u002Fpath><\u002Fsvg>\n              <\u002Fspan>\n              <h3 class=\"serif\" style=\"margin:0;font-weight:400;font-size:30px;line-height:1.1\">Seat booked<\u002Fh3>\n            <\u002Fdiv>\n            <div>\n              <p class=\"serif\" style=\"margin:0;font-size:26px;line-height:1.15\">{{selLabel}}<\u002Fp>\n              <p style=\"margin:6px 0 0;font-size:15px;color:#FFC247\">{{selKind}}<\u002Fp>\n            <\u002Fdiv>\n            <dl style=\"margin:0;display:grid;grid-template-columns:auto 1fr;gap:12px 20px;font-size:15px;border-top:1px solid #2A313C;padding-top:20px\">\n              <dt style=\"color:#98A1AE\">Floor<\u002Fdt><dd style=\"margin:0;text-align:right\">{{selLevel}}<\u002Fdd>\n              <dt style=\"color:#98A1AE\">Day<\u002Fdt><dd style=\"margin:0;text-align:right\">{{selDay}}<\u002Fdd>\n              <dt style=\"color:#98A1AE\">Time<\u002Fdt><dd style=\"margin:0;text-align:right\">{{selTime}}<\u002Fdd>\n            <\u002Fdl>\n            <button class=\"btn sec sm\" sc-camel-on-click=\"{{again}}\">Book another seat<\u002Fbutton>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n      <\u002Faside>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <footer style=\"border-top:1px solid #232A33;padding:32px 40px\">\n    <div style=\"max-width:1200px;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 40px;font-size:14px;color:#98A1AE\">\n      <span class=\"serif\" style=\"font-size:18px;color:#F3EFE6\">Lumen Library<\u002Fspan>\n      <span>Opening hours: [OPENING HOURS]<\u002Fspan>\n      <span>Help desk: [CONTACT DETAILS]<\u002Fspan>\n    <\u002Fdiv>\n  <\u002Ffooter>\n<\u002Fdiv>\n<\u002Fx-dc>\n\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:1360,&quot;height&quot;:2000}}\">\nclass Component extends DCLogic {\n  constructor(props) {\n    super(props);\n    this.state = { floor: 0, day: 0, slot: 1, sel: null, done: false, view: 'iso', rot: -35, tilt: 58, zoom: 1 };\n  }\n\n  layout() {\n    const out = [];\n    for (let t = 0; t < 6; t++) {\n      const cx = ((t % 3) - 1) * 230;\n      const cy = t < 3 ? -60 : 110;\n      for (let side = 0; side < 2; side++) {\n        for (let k = 0; k < 3; k++) {\n          const n = side * 3 + k + 1;\n          out.push({ id: 'T' + (t + 1) + '-' + n, label: 'Table ' + (t + 1) + ' · Seat ' + n, kind: 'Shared table', x: cx + (k - 1) * 50, y: cy + (side === 0 ? -48 : 48), rz: side === 0 ? 180 : 0 });\n        }\n      }\n    }\n    for (let c = 0; c < 8; c++) {\n      out.push({ id: 'C' + (c + 1), label: 'Carrel ' + (c + 1), kind: 'Quiet carrel', x: -280 + c * 80, y: -190, rz: 0 });\n    }\n    return out;\n  }\n\n  isTaken(i) {\n    const s = this.state;\n    let h = Math.imul(i + 1, 2654435761) ^ Math.imul(s.floor + 3, 40503) ^ Math.imul(s.day + 5, 9301) ^ Math.imul(s.slot + 7, 7919);\n    h = Math.imul(h ^ (h >>> 15), 2246822519);\n    h = h ^ (h >>> 13);\n    return ((h >>> 0) % 100) < 36;\n  }\n\n  renderVals() {\n    const s = this.state;\n    const self = this;\n    const levelDefs = [\n      { name: 'Ground floor', sub: 'Reading hall' },\n      { name: 'First floor', sub: 'Silent study' }\n    ];\n    const slotDefs = ['9:00 – 12:00', '12:00 – 15:00', '15:00 – 18:00', '18:00 – 21:00'];\n    const wd = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];\n    const mo = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n    const now = new Date();\n\n    const levels = levelDefs.map((l, i) => ({\n      name: l.name, sub: l.sub,\n      cls: i === s.floor ? 'chip on' : 'chip',\n      pressed: i === s.floor ? 'true' : 'false',\n      pick: () => self.setState({ floor: i, done: false })\n    }));\n\n    const days = [0, 1, 2, 3, 4].map((i) => {\n      const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() + i);\n      return {\n        wd: i === 0 ? 'Today' : wd[d.getDay()],\n        num: d.getDate(), mon: mo[d.getMonth()],\n        full: wd[d.getDay()] + ' ' + d.getDate() + ' ' + mo[d.getMonth()],\n        cls: i === s.day ? 'chip on' : 'chip',\n        pressed: i === s.day ? 'true' : 'false',\n        pick: () => self.setState({ day: i, done: false })\n      };\n    });\n\n    const slots = slotDefs.map((label, i) => ({\n      label,\n      cls: i === s.slot ? 'chip on' : 'chip',\n      pressed: i === s.slot ? 'true' : 'false',\n      pick: () => self.setState({ slot: i, done: false })\n    }));\n\n    const lay = this.layout();\n    const seats = lay.map((q, i) => {\n      const taken = self.isTaken(i);\n      const sel = !taken && s.sel === q.id;\n      const state = taken ? 'taken' : (sel ? 'sel' : 'free');\n      return {\n        id: q.id, label: q.label, kind: q.kind, taken, sel, state,\n        tf: 'translate3d(' + q.x + 'px,' + q.y + 'px,0) rotateZ(' + q.rz + 'deg)',\n        aria: q.label + ', ' + (taken ? 'taken' : (sel ? 'selected' : 'free')),\n        pick: () => self.setState({ sel: q.id, done: false })\n      };\n    });\n    const freeCount = seats.filter((x) => !x.taken).length;\n    const chosen = seats.find((x) => x.sel) || null;\n    const firstFree = seats.find((x) => !x.taken) || null;\n\n    const tables = [];\n    for (let t = 0; t < 6; t++) {\n      tables.push({ tf: 'translate3d(' + (((t % 3) - 1) * 230) + 'px,' + (t < 3 ? -60 : 110) + 'px,0)' });\n    }\n    const carrels = [];\n    for (let c = 0; c < 8; c++) {\n      carrels.push({ tf: 'translate3d(' + (-280 + c * 80) + 'px,-222px,0)' });\n    }\n\n    const viewDefs = [\n      { key: 'iso', label: 'Isometric', rot: -35, tilt: 58 },\n      { key: 'top', label: 'Top-down', rot: 0, tilt: 0 },\n      { key: 'eye', label: 'Eye level', rot: 0, tilt: 76 }\n    ];\n    const views = viewDefs.map((v) => ({\n      label: v.label,\n      cls: s.view === v.key ? 'hud on' : 'hud',\n      pressed: s.view === v.key ? 'true' : 'false',\n      pick: () => self.setState({ view: v.key, rot: v.rot, tilt: v.tilt, zoom: 1 })\n    }));\n\n    const clamp = (z) => Math.max(0.6, Math.min(1.7, z));\n    const lv = levelDefs[s.floor];\n\n    return {\n      levelName: lv.name + ' · ' + lv.sub,\n      freeCount, total: seats.length,\n      levels, days, slots, seats, tables, carrels, views,\n      sceneTf: 'rotateX(' + s.tilt + 'deg) rotateZ(' + s.rot + 'deg) scale(' + s.zoom + ')',\n      rotL: () => self.setState({ view: 'custom', rot: s.rot - 45 }),\n      rotR: () => self.setState({ view: 'custom', rot: s.rot + 45 }),\n      zoomIn: () => self.setState({ zoom: clamp(s.zoom + 0.15) }),\n      zoomOut: () => self.setState({ zoom: clamp(s.zoom - 0.15) }),\n      noSel: !chosen,\n      confirmable: !!chosen && !s.done,\n      done: !!chosen && s.done,\n      selLabel: chosen ? chosen.label : '',\n      selKind: chosen ? chosen.kind : '',\n      selLevel: lv.name + ' · ' + lv.sub,\n      selDay: days[s.day].full,\n      selTime: slotDefs[s.slot],\n      pickForMe: () => { if (firstFree) self.setState({ sel: firstFree.id, done: false }); },\n      confirm: () => self.setState({ done: true }),\n      clearSel: () => self.setState({ sel: null, done: false }),\n      again: () => self.setState({ sel: null, done: false })\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html><!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Lumen Library — Admin Panel</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:wght@500;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#0E1116;color:#F3EFE6;font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased;display:flex;min-height:100vh}
.sidebar{width:260px;background:#12171E;border-right:1px solid #232A33;padding:24px 18px;position:sticky;top:0;height:100vh;overflow:auto}
.logo{font-family:'Fraunces',Georgia,serif;font-size:22px;font-weight:600;margin-bottom:4px}
.sub{color:#98A1AE;font-size:12px;margin-bottom:24px}
.nav a{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:12px;color:#98A1AE;text-decoration:none;margin-bottom:4px;cursor:pointer;transition:.15s;font-size:14px;font-weight:500}
.nav a:hover,.nav a.active{background:#1D242E;color:#F3EFE6}
.main{flex:1;padding:28px 32px;overflow:auto}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;gap:12px;flex-wrap:wrap}
.title{font-family:'Fraunces',Georgia,serif;font-size:30px;font-weight:600}
.card{background:#12171E;border:1px solid #232A33;border-radius:20px;padding:24px;margin-bottom:16px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px}
.stat{font-size:34px;font-weight:700;font-family:'Fraunces',Georgia,serif}
.statlabel{color:#98A1AE;font-size:13px;margin-top:4px}
.tag{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:999px;font:600 12px 'DM Sans',system-ui,sans-serif;white-space:nowrap}
.tag.ok{background:#14301F;color:#8FE0A8}.tag.warn{background:#3A2D0F;color:#FFC247}.tag.bad{background:#3D1C1C;color:#FF9E9E}.tag.neu{background:#1D242E;color:#C9CFD8}
table{width:100%;border-collapse:collapse}
th,td{padding:14px 12px;text-align:left;border-top:1px solid #232A33;font-size:14px}
th{color:#98A1AE;font-weight:600;font-size:12px;letter-spacing:.1em;text-transform:uppercase}
tr:first-child th,tr:first-child td{border-top:0}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:0 16px;border-radius:999px;font:600 14px 'DM Sans',system-ui,sans-serif;cursor:pointer;text-decoration:none;border:1px solid #3A424F;background:transparent;color:#F3EFE6;transition:.15s}
.btn:hover{border-color:#8C96A5}
.btn.pri{background:#FFC247;color:#1A1405;border-color:#FFC247}.btn.pri:hover{background:#FFD27A}
.btn.danger{background:#3D1C1C;color:#FF9E9E;border-color:#5A2B2B}
.btn.sm{min-height:36px;padding:0 12px;font-size:13px}
.input{padding:10px 14px;border-radius:12px;border:1px solid #3A424F;background:#0E1116;color:#F3EFE6;width:100%;font:500 14px 'DM Sans',system-ui,sans-serif}
.input:focus{outline:2px solid #FFC247;outline-offset:2px}
.row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.section{display:none}.section.active{display:block}
.toggle{width:44px;height:24px;background:#1D242E;border-radius:999px;position:relative;cursor:pointer;transition:.2s;border:1px solid #3A424F}
.toggle.on{background:#FFC247}
.toggle::after{content:'';position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:#F3EFE6;transition:.2s}
.toggle.on::after{left:23px;background:#1A1405}
.blur{filter:blur(4px);opacity:.7}
.modal-back{position:fixed;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center;z-index:100}
.modal-back.open{display:flex}
.modal{background:#12171E;border:1px solid #232A33;border-radius:20px;padding:28px;min-width:360px;max-width:90vw}
h3{font-family:'Fraunces',Georgia,serif;font-size:20px;font-weight:600;margin-bottom:14px}
.lbl{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#98A1AE;margin:0 0 6px}
</style>
</head>
<body>
<aside class="sidebar">
  <div class="logo">Lumen Library</div>
  <div class="sub">Admin Panel · Superadmin</div>
  <nav class="nav">
    <a class="active" data-sec="dashboard">Dashboard</a>
    <a data-sec="users">Users & Roles</a>
    <a data-sec="librarians">Librarians</a>
    <a data-sec="students">Students</a>
    <a data-sec="catalogue">Catalogue</a>
    <a data-sec="seats">Seat Booking</a>
    <a data-sec="payments">Payments</a>
    <a data-sec="fines">Fines</a>
    <a data-sec="sessions">Sessions</a>
    <a data-sec="settings">Settings & Security</a>
  </nav>
</aside>
<main class="main">
  <div class="topbar">
    <div class="title" id="title">Dashboard</div>
    <div class="row">
      <input class="input" style="width:220px" placeholder="Search...">
      <button class="btn">Export</button>
      <button class="btn pri">+ New</button>
    </div>
  </div>

  <section class="section active" id="dashboard">
    <div class="grid">
      <div class="card"><div class="stat">1,284</div><div class="statlabel">Active members</div></div>
      <div class="card"><div class="stat">342</div><div class="statlabel">Books issued</div></div>
      <div class="card"><div class="stat">₹48,200</div><div class="statlabel">Revenue (month)</div></div>
      <div class="card"><div class="stat">12</div><div class="statlabel">Pending payments</div></div>
    </div>
    <div class="card">
      <h3>Pending payment approvals</h3>
      <table><thead><tr><th>User</th><th>Amount</th><th>Method</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <tr><td>Rahul Sharma</td><td>₹1,200</td><td>Razorpay</td><td><span class="tag warn">Pending</span></td><td><button class="btn pri sm">Approve</button> <button class="btn danger sm">Reject</button></td></tr>
        <tr><td>Priya Verma</td><td>₹800</td><td>Physical</td><td><span class="tag warn">Pending</span></td><td><button class="btn pri sm">Approve</button> <button class="btn danger sm">Reject</button></td></tr>
      </tbody></table>
    </div>
  </section>

  <section class="section" id="users">
    <div class="card"><h3>Role management</h3>
      <table><thead><tr><th>Role</th><th>Permissions</th><th>Users</th><th>Toggle</th></tr></thead>
      <tbody>
        <tr><td>Superadmin</td><td>All access, DB, cookies, caches</td><td>1</td><td><div class="toggle on"></div></td></tr>
        <tr><td>Admin</td><td>Library, members, payments, seats</td><td>2</td><td><div class="toggle on"></div></td></tr>
        <tr><td>Librarian</td><td>Catalogue, issue/return</td><td>6</td><td><div class="toggle on"></div></td></tr>
        <tr><td>Student</td><td>Book, pay, view loans</td><td>1275</td><td><div class="toggle on"></div></td></tr>
      </tbody></table>
    </div>
  </section>

  <section class="section" id="librarians">
    <div class="card"><h3>Librarian management</h3>
      <table><thead><tr><th>Name</th><th>Email</th><th>Branch</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <tr><td>Anita Rao</td><td>anita@lumen.in</td><td>Main</td><td><span class="tag ok">Active</span></td><td><button class="btn sm">Edit</button></td></tr>
        <tr><td>Vikram Das</td><td>vikram@lumen.in</td><td>Annex</td><td><span class="tag ok">Active</span></td><td><button class="btn sm">Edit</button></td></tr>
      </tbody></table>
    </div>
  </section>

  <section class="section" id="students">
    <div class="card"><h3>Student management</h3>
      <table><thead><tr><th>Name</th><th>ID</th><th>Membership</th><th>Fines</th><th>Action</th></tr></thead>
      <tbody>
        <tr><td>Rahul Sharma</td><td>STU-1042</td><td>Premium</td><td>₹0</td><td><button class="btn sm">View</button></td></tr>
        <tr><td>Priya Verma</td><td>STU-1088</td><td>Basic</td><td>₹120</td><td><button class="btn sm">View</button></td></tr>
      </tbody></table>
    </div>
  </section>

  <section class="section" id="catalogue">
    <div class="card"><h3>Catalogue management</h3>
      <table><thead><tr><th>Title</th><th>Author</th><th>Copies</th><th>Available</th><th>Action</th></tr></thead>
      <tbody>
        <tr><td>Atomic Habits</td><td>James Clear</td><td>12</td><td>4</td><td><button class="btn sm">Edit</button></td></tr>
        <tr><td>Deep Work</td><td>Cal Newport</td><td>8</td><td>2</td><td><button class="btn sm">Edit</button></td></tr>
      </tbody></table>
    </div>
  </section>

  <section class="section" id="seats">
    <div class="card"><h3>Seat booking management</h3>
      <table><thead><tr><th>Seat</th><th>User</th><th>Time</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <tr><td>A-12</td><td>Rahul Sharma</td><td>10:00–12:00</td><td><span class="tag ok">Booked</span></td><td><button class="btn danger sm">Release</button></td></tr>
        <tr><td>B-04</td><td>—</td><td>—</td><td><span class="tag warn">Free</span></td><td><button class="btn pri sm">Assign</button></td></tr>
      </tbody></table>
    </div>
  </section>

  <section class="section" id="payments">
    <div class="card"><h3>Payment gateways (Razorpay)</h3>
      <div class="row"><label class="lbl" style="margin:0">Key ID</label><input class="input" value="rzp_live_xxxxx" style="width:260px"><button class="btn pri sm">Save</button></div>
      <div class="row" style="margin-top:12px"><label class="lbl" style="margin:0">Secret</label><input class="input" type="password" value="••••••••" style="width:260px"><button class="btn sm">Rotate</button></div>
      <p style="color:#98A1AE;font-size:13px;margin-top:10px">Methods: UPI, Cards, Netbanking, Wallets, EMI. Auto-capture on approve.</p>
    </div>
    <div class="card"><h3>Payment records</h3>
      <table><thead><tr><th>User</th><th>Amount</th><th>Gateway</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <tr><td>Rahul Sharma</td><td>₹1,200</td><td>Razorpay</td><td><span class="tag warn">Pending</span></td><td><button class="btn pri sm">Confirm</button></td></tr>
        <tr><td>Priya Verma</td><td>₹800</td><td>Physical</td><td><span class="tag ok">Approved</span></td><td><button class="btn sm">Receipt</button></td></tr>
      </tbody></table>
    </div>
  </section>

  <section class="section" id="fines">
    <div class="card"><h3>Fines</h3>
      <table><thead><tr><th>User</th><th>Reason</th><th>Amount</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <tr><td>Priya Verma</td><td>Late return</td><td>₹120</td><td><span class="tag warn">Unpaid</span></td><td><button class="btn pri sm">Mark Paid</button></td></tr>
      </tbody></table>
    </div>
  </section>

  <section class="section" id="sessions">
    <div class="card"><h3>Active sessions</h3>
      <table><thead><tr><th>User</th><th>Device</th><th>IP</th><th>Last seen</th><th>Action</th></tr></thead>
      <tbody>
        <tr><td>Rahul Sharma</td><td>Chrome/Windows</td><td>192.168.1.4</td><td>2m ago</td><td><button class="btn danger sm">Revoke</button></td></tr>
      </tbody></table>
    </div>
  </section>

  <section class="section" id="settings">
    <div class="card"><h3>Security & developer settings</h3>
      <div class="row"><span>Cache clearing (superadmin)</span><button class="btn danger sm">Clear caches</button></div>
      <div class="row" style="margin-top:12px"><span>Cookie management</span><button class="btn sm">Manage cookies</button></div>
      <div class="row" style="margin-top:12px"><span>Database backup</span><button class="btn pri sm">Backup now</button></div>
      <div class="row" style="margin-top:12px"><span>Forgot password flow</span><div class="toggle on"></div></div>
      <div class="row" style="margin-top:12px"><span>Terms & conditions</span><button class="btn sm">Edit T&C</button></div>
    </div>
  </section>
</main>
<script>
const titles={dashboard:'Dashboard',users:'Users & Roles',librarians:'Librarians',students:'Students',catalogue:'Catalogue',seats:'Seat Booking',payments:'Payments',fines:'Fines',sessions:'Sessions',settings:'Settings & Security'};
document.querySelectorAll('.nav a').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();document.querySelectorAll('.nav a').forEach(x=>x.classList.remove('active'));a.classList.add('active');const s=a.dataset.sec;document.querySelectorAll('.section').forEach(x=>x.classList.remove('active'));document.getElementById(s).classList.add('active');document.getElementById('title').textContent=titles[s];}));
document.querySelectorAll('.toggle').forEach(t=>t.addEventListener('click',()=>t.classList.toggle('on')));
</script>
</body>
</html>
